    {
      "parameters": {
        "jsCode": "// Heti munkaidĹ‘ Ă¶sszesĂ­tĹ‘ szĂˇmĂ­tĂˇs\nconst records = $input.all();\nconst chatId = $('Telegram Trigger').item.json.message.chat.id;\nconst firstName = $('Telegram Trigger').item.json.message.chat.first_name || 'DolgozĂł';\n\nlet totalRecords = records.length;\nlet message = `đź“… **${firstName} - Heti munkaidĹ‘ Ă¶sszesĂ­tĹ‘:**\\n\\n`;\n\nif (totalRecords === 0) {\n  message += 'âťŚ Az elmĂşlt 7 napban nincs rĂ¶gzĂ­tett munkaidĹ‘.\\n';\n} else {\n  message += `âś… **${totalRecords}** bejegyzĂ©s az elmĂşlt 7 napban.\\n\\n`;\n  \n  // DĂˇtum szerint csoportosĂ­tĂˇs\n  const byDate = {};\n  records.forEach(record => {\n    const date = record.json.DĂˇtum || 'Ismeretlen';\n    if (!byDate[date]) {\n      byDate[date] = [];\n    }\n    byDate[date].push(record.json.MegjegyzĂ©s || 'Nincs megjegyzĂ©s');\n  });\n  \n  // DĂˇtum szerint rendezĂ©s\n  const sortedDates = Object.keys(byDate).sort().reverse();\n  \n  sortedDates.forEach(date => {\n    message += `\\nđź“† **${date}**\\n`;\n    byDate[date].forEach((megjegyzes, index) => {\n      message += `  ${index + 1}. ${megjegyzes}\\n`;\n    });\n  });\n}\n\nmessage += '\\nđź’ˇ HasznĂˇld a /statusz parancsot a mai stĂˇtuszhoz.';\n\nreturn [{\n  json: {\n    message: message,\n    chatId: chatId,\n    totalRecords: totalRecords\n  }\n}];"
      },
