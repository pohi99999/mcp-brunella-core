{
  "folders": [
    {
      "name": "mcp-brunella-core",
      "path": "."
    }
  ],
  "settings": {
    "github.copilot.editor.enableCodeActions": true,
    "search.exclude": {
      "**/node_modules": true,
      "**/__pycache__": true,
      "**/.git": true,
      "**/.venv": true,
      "**/coverage": true,
      "**/dist": true,
      "**/build": true,
      "**/playwright-report": true,
      "**/test-results": true,
      "**/.pytest_tmp": true,
      "**/*.lock": true
    },
    "files.watcherExclude": {
      "**/.git/objects/**": true,
      "**/.git/subtree-cache/**": true,
      "**/node_modules/**": true,
      "**/__pycache__/**": true,
      "**/.venv/**": true,
      "**/coverage/**": true,
      "**/dist/**": true,
      "**/build/**": true,
      "**/playwright-report/**": true,
      "**/test-results/**": true,
      "**/.pytest_tmp/**": true
    },
    "files.associations": {
      "*.md": "markdown",
      "CONDUCTOR_MANIFEST.md": "markdown",
      "*.jsonc": "jsonc",
      "Modelfile": "dockerfile"
    },
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.aiStats.enabled": false,
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "debug.internalConsoleOptions": "neverOpen",
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": [
      "tests/python",
      "myai/tests"
    ],
    "python.testing.unittestEnabled": false,
    "python.analysis.typeCheckingMode": "basic",
    "vitest.disableWorkspaceWarning": true,
    "github.copilot.chat.languageContext.fix.typescript.enabled": true,
    "github.copilot.chat.languageContext.inline.typescript.enabled": true,
    "github.copilot.chat.languageContext.typescript.enabled": true,
    "github.copilot.chat.languageContext.typescript.includeDocumentation": true,
    "github.copilot.chat.notebook.enhancedNextEditSuggestions.enabled": true,
    "github.copilot.chat.githubMcpServer.enabled": true,
    "github.copilot.chat.githubMcpServer.lockdown": true,
    "github.copilot.chat.githubMcpServer.readonly": true,
    "github.copilot.chat.cli.mcp.enabled": true,
    "github.copilot.chat.searchSubagent.enabled": true,
    "github.copilot.chat.searchSubagent.useAgenticProxy": true,
    "chat.customAgentInSubagent.enabled": true,
    "chat.agentSessionProjection.enabled": true,
    "chat.unifiedAgentsBar.enabled": true,
    "chat.includeReferencedInstructions": true,
    "chat.useNestedAgentsMdFiles": true,
    "chat.mcp.discovery.enabled": {
      "claude-desktop": true,
      "windsurf": true,
      "cursor-global": true,
      "cursor-workspace": true
    },
    "DockerRun.DisableDockerrc": true,
    "azureFunctions.projectSubpath": "external_research\\brunella_azure\\app\\functions\\text_processor",
    "azureFunctions.deploySubpath": "external_research\\brunella_azure\\app\\functions\\text_processor",
    "azureFunctions.projectLanguage": "PowerShell",
    "azureFunctions.projectRuntime": "~4",
    "js/ts.preferences.preferTypeOnlyAutoImports": true,
    "js/ts.suggest.completeFunctionCalls": true,
    "npm.enableRunFromFolder": true,
    "npm.runSilent": true,
    "playwright.reuseBrowser": true,
    "playwright.showTrace": false,
    "search.useGlobalIgnoreFiles": true,
    "search.useParentIgnoreFiles": true,
    "yaml.disableAdditionalProperties": true,
    "yaml.disableDefaultProperties": true,
    "chat.agent.sandbox.enabled": "on",
    "cSpell.blockCheckingWhenLineLengthGreaterThan": 40000,
    "github.copilot.chat.otel.enabled": true,
    "github.copilot.chat.agent.autoFix": true,
    "github.copilot.chat.claudeAgent.allowDangerouslySkipPermissions": true,
    "github.copilot.chat.cli.branchSupport.enabled": true,
    "github.copilot.chat.cli.forkSessions.enabled": true,
    "github.copilot.chat.cli.planExitMode.enabled": true,
    "github.copilot.chat.cli.sessionController.enabled": true,
    "github.copilot.chat.cli.sessionControllerForSessionsApp.enabled": true,
    "github.copilot.chat.otel.captureContent": true,
    "github.copilot.chat.otel.dbSpanExporter.enabled": true,
    "github.copilot.chat.scopeSelection": true,
    "github.copilot.chat.conversationTranscriptLookup.enabled": true,
    "github.copilot.chat.codesearch.enabled": true,
    "github.copilot.enable": {
      "plaintext": true,
      "markdown": true,
      "scminput": true
    },
    "github.copilot.chat.copilotMemory.enabled": true,
    "github.copilot.chat.agent.omitFileAttachmentContents": true,
    "github.copilot.chat.agentDebugLog.enabled": true,
    "github.copilot.chat.agentDebugLog.fileLogging.enabled": true,
    "github.copilot.chat.agentHistorySummarizationInline": true,
    "github.copilot.chat.alternateGeminiModelFPrompt.enabled": true,
    "github.copilot.chat.alternateGptPrompt.enabled": true,
    "github.copilot.chat.anthropic.tools.websearch.enabled": true,
    "github.copilot.chat.editRecording.enabled": true,
    "github.copilot.chat.edits.batchReplaceStringDescriptions": true,
    "github.copilot.chat.edits.gemini3MultiReplaceString": true,
    "github.copilot.chat.enableUserPreferences": true,
    "github.copilot.chat.executionSubagent.enabled": true,
    "github.copilot.chat.feedback.onChange": true,
    "github.copilot.chat.gpt54LargePrompt.enabled": true,
    "github.copilot.chat.gpt5AlternativePatch": true,
    "github.copilot.chat.inlineEdits.diagnosticsContextProvider.enabled": true,
    "github.copilot.chat.installExtensionSkill.enabled": true,
    "github.copilot.chat.localWorkspaceRecording.enabled": true,
    "github.copilot.chat.newWorkspace.useContext7": true,
    "github.copilot.chat.notebook.alternativeNESFormat.enabled": true,
    "github.copilot.chat.notebook.followCellExecution.enabled": true,
    "github.copilot.chat.notebook.summaryExperimentEnabled": true,
    "github.copilot.chat.omitBaseAgentInstructions": true,
    "github.copilot.chat.notebook.variableFilteringEnabled": true,
    "github.copilot.chat.projectLabels.chat": true,
    "github.copilot.chat.projectLabels.expanded": true,
    "github.copilot.chat.projectSetupInfoSkill.enabled": true,
    "github.copilot.chat.projectLabels.inline": true,
    "github.copilot.chat.responsesApiContextManagement.enabled": true,
    "github.copilot.chat.review.intent": true,
    "github.copilot.chat.tools.defaultToolsGrouped": true,
    "github.copilot.chat.switchAgent.enabled": true,
    "github.copilot.chat.useResponsesApiTruncation": true
  },
  "extensions": {
    "recommendations": [
      "github.copilot",
      "github.vscode-pull-request-github",
      "github.copilot-workspace",
      "upstash.context7-mcp",
      "automatalabs.copilot-mcp",
      "dhananjaysenday.mcp--inspector",
      "alessandrobenassi.cloudflare-devtools",
      "ms-azuretools.vscode-azure-github-copilot",
      "ms-azuretools.vscode-azureappservice",
      "vscjava.migrate-java-to-azure",
      "google.gemini-cli-vscode-ide-companion",
      "conductor.conductor",
      "cweijan.chat-copilot"
    ]
  }
}
