# ============================================
# AI RESEARCH PIPELINE - Environment Variables
# ============================================
# Másold át ezt a fájlt .env néven és töltsd ki az API key-eket!

# ============================================
# LLM API KEYS
# ============================================
# Perplexity (web search)
PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI (opcionális, ha GPT modelleket is használnál)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# TELEGRAM NOTIFICATIONS
# ============================================
# Bot token (BotFather-től kapod)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz1234567890

# Chat ID (ahova az értesítések mennek)
# Megtalálod: @userinfobot-tal vagy @RawDataBot-tal
TELEGRAM_CHAT_ID=123456789

# ============================================
# LANGFLOW SETTINGS
# ============================================
# Admin felhasználó
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=ChangeMe123!

# Secret key (generálj egy erős random stringet!)
# Parancs: openssl rand -hex 32
LANGFLOW_SECRET_KEY=your-generated-secret-key-here-64-chars-long

# ============================================
# CHROMADB AUTHENTICATION
# ============================================
# Auth token a ChromaDB API hívásokhoz
# Generálás: openssl rand -hex 16
CHROMA_AUTH_TOKEN=change-this-token-to-something-secure

# ============================================
# POSTGRES (ha használod SQLite helyett)
# ============================================
# POSTGRES_PASSWORD=strong_password_here

# ============================================
# GOOGLE DRIVE (jövőbeli bővítéshez)
# ============================================
# GOOGLE_DRIVE_FOLDER_ID=1XX-rnaM2I1an3DVD4c-kmvR0jmma-fGn
# GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service-account.json

# ============================================
# AIRTABLE (n8n integráció)
# ============================================
# AIRTABLE_API_KEY=patxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AIRTABLE_BASE_ID=appxxxxxxxxxxxxxxx

# ============================================
# SYSTEM SETTINGS
# ============================================
# Időzóna
TZ=Europe/Budapest

# Log level
LOG_LEVEL=INFO
