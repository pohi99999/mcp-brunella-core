{
  "name": "BAS Task Handler",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "bas-task",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-entry",
      "name": "BAS Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "bas-task-webhook"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-research",
              "leftValue": "={{ $json.type }}",
              "rightValue": "research",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "switch-type",
      "name": "Task Router",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [470, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:7860/api/v1/run/bas-research",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"input_value\": \"{{ $json.payload.instruction }}\",\n  \"output_type\": \"chat\",\n  \"input_type\": \"chat\",\n  \"tweaks\": {\n    \"task_id\": \"{{ $json.taskId }}\",\n    \"context\": {{ JSON.stringify($json.payload.context || {}) }}\n  }\n}",
        "options": {}
      },
      "id": "langflow-research",
      "name": "Langflow Research",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 180]
    },
    {
      "parameters": {
        "model": "llama3.1:8b",
        "baseUrl": "http://localhost:11434",
        "options": {
          "temperature": 0.7
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "Te a BAS Code Agent vagy. Generálj tiszta, jól dokumentált kódot a kérés alapján. Válaszolj CSAK kóddal és rövid magyarázattal."
            },
            {
              "role": "user",
              "content": "={{ $json.payload.instruction }}\n\nKontextus: {{ JSON.stringify($json.payload.context || {}) }}"
            }
          ]
        }
      },
      "id": "ollama-code",
      "name": "Ollama Code Gen",
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "typeVersion": 1,
      "position": [700, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:7860/api/v1/run/bas-orchestrator",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"input_value\": \"{{ $json.payload.instruction }}\",\n  \"output_type\": \"chat\",\n  \"input_type\": \"chat\",\n  \"tweaks\": {\n    \"task_id\": \"{{ $json.taskId }}\",\n    \"sub_tasks\": true\n  }\n}",
        "options": {}
      },
      "id": "langflow-orchestrate",
      "name": "Langflow Orchestrator",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 420]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('BAS Webhook').item.json.callbackUrl }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"taskId\": \"{{ $('BAS Webhook').item.json.taskId }}\",\n  \"status\": \"success\",\n  \"result\": {{ JSON.stringify($json) }}\n}",
        "options": {}
      },
      "id": "callback-success",
      "name": "Callback Success",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [950, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"received\": true,\n  \"taskId\": \"{{ $('BAS Webhook').item.json.taskId }}\",\n  \"status\": \"processing\"\n}",
        "options": {}
      },
      "id": "respond-webhook",
      "name": "Respond Accepted",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1150, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('BAS Webhook').item.json.callbackUrl }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"taskId\": \"{{ $('BAS Webhook').item.json.taskId }}\",\n  \"status\": \"failed\",\n  \"result\": {\n    \"error\": \"{{ $json.error.message || 'Unknown error' }}\"\n  }\n}",
        "options": {}
      },
      "id": "callback-error",
      "name": "Callback Error",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [950, 500]
    }
  ],
