{
    // --- 1. CORE COPILOT PRO+ INTELLIGENCE ---
    // Engedélyezzük a Copilotnak, hogy parancsokat futtasson és javítson
    "github.copilot.editor.enableAutoCompletions": true,
    "github.copilot.editor.enableCodeActions": true,
    "github.copilot.chat.runCommand.enabled": true,
    "github.copilot.chat.experimental.commandConfirmation": true, // Gyorsabb végrehajtás kérdezés nélkül
    // Codebase Awareness: Ez a legfontosabb a "Context" szempontjából
    "github.copilot.advanced": {
        "listFilesLimit": 32000 // Növelt limit, hogy lássa a teljes BAS struktúrát
    },
    "github.copilot.chat.search.semanticTextResults": true, // Értse a jelentést, ne csak kulcsszavakat keressen
    // --- 2. ZAJSZŰRÉS (NOISE CANCELLATION) ---
    // Ezeket a mappákat elrejtjük a Copilot elől, hogy ne pazarolja a tokeneket
    "search.exclude": {
        "**/node_modules": true,
        "**/__pycache__": true,
        "**/.git": true,
        "**/.venv": true,
        "**/coverage": true,
        "**/dist": true,
        "**/build": true, // A build kimenet ne zavarja a forráskód értelmezését
        "**/*.lock": true
    },
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/node_modules/**": true,
        "**/__pycache__/**": true
    },
    // --- 3. BAS PROJEKT SPECIFIKUSOK ---
    // Segítünk a rendszernek érteni a fájltípusokat
    "files.associations": {
        "*.md": "markdown",
        "CONDUCTOR_MANIFEST.md": "markdown", // A Conductor fájlok kiemelése
        "*.jsonc": "jsonc",
        "Modelfile": "dockerfile" // Az Ollama fájlokhoz syntax highlight
    },
    // --- 4. PYTHON & TESTING (Robotkéz támogatás) ---
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
    "python.testing.unittestArgs": [
        "-v",
        "-s",
        "./tests", // Javaslom a 'tests' mappát a 'build' helyett, ha ott vannak a forrástesztek
        "-p",
        "*test.py"
    ],
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": true,
    "python.analysis.typeCheckingMode": "basic",
    // --- 5. EDITOR UX ---
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "GitHub.copilot-chat",
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    // --- LEGACY / EGYÉB (Megtartva, de rendezve) ---
    "vitest.disableWorkspaceWarning": true,
    "git.ignoreLimitWarning": true,
    "chatgpt.openOnStartup": true,
    "editor.aiStats.enabled": false,
    "github.copilot.chat.agentCustomizationSkill.enabled": true,
    "github.copilot.chat.languageContext.fix.typescript.enabled": true,
    "github.copilot.chat.languageContext.inline.typescript.enabled": true,
    "github.copilot.chat.languageContext.typescript.enabled": true,
    "github.copilot.chat.notebook.enhancedNextEditSuggestions.enabled": true,
    "chat.customAgentInSubagent.enabled": true,
    "chat.agentSessionProjection.enabled": true,
    "chat.unifiedAgentsBar.enabled": true,
    "DockerRun.DisableDockerrc": true,
