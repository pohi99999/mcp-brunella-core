{
  "name": "KKV CRM Followup Routing",
  "nodes": [
    {
      "id": "1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "kkv-followup",
        "responseMode": "onReceived"
      }
    },
    {
      "id": "2",
      "name": "Verify Signature (optional)",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [500, 300],
      "parameters": {
        "functionCode": "// Optional HMAC verification: if WEBHOOK_SECRET is set we verify, otherwise accept for quick smoke tests\nconst raw = JSON.stringify(items[0].json || {});\nconst headers = (items[0].json && items[0].json.headers) || {};\nconst signature = headers['x-crm-signature'] || headers['X-CRM-SIGNATURE'];\nconst secret = process.env.WEBHOOK_SECRET;\nif (secret && signature) {\n  const crypto = require('crypto');\n  const h = crypto.createHmac('sha256', secret).update(raw).digest('hex');\n  if (signature !== `sha256=${h}`) {\n    throw new Error('invalid signature');\n  }\n}\nreturn items;"
      }
    },
    {
      "id": "3",
      "name": "Idempotency Check (placeholder)",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [750, 300],
      "parameters": {
        "functionCode": "// Idempotency placeholder for smoke tests\n// In production, check Redis/DB for event_id and bail-out if duplicate\nreturn items;"
      }
    },
    {
      "id": "4",
      "name": "Call Orchestrator",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [1000, 300],
      "parameters": {
        "url": "={{$env.ORCHESTRATOR_URL || 'http://localhost:3000/api/v1/followups'}}",
        "method": "POST",
        "jsonParameters": true,
        "options": {},
        "bodyParametersJson": "={\"lead_id\": $json[\"lead_id\"], \"owner_id\": $json[\"owner_id\"], \"note\": \"Automated follow-up (n8n smoke)\"}"
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Verify Signature (optional)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify Signature (optional)": {
      "main": [
        [
          {
            "node": "Idempotency Check (placeholder)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Idempotency Check (placeholder)": {
      "main": [
        [
          {
            "node": "Call Orchestrator",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {}
}
