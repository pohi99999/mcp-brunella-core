{
  "name": "Brunella Bookkeeping Weekly Report Live",
  "nodes": [
    {
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "mode": "everyX",
              "value": 168,
              "unit": "hours"
            }
          ]
        }
      },
      "id": "weekly-cron",
      "name": "Cron Trigger (Weekly)",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        260,
        320
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://localhost:3000/api/v1/bookkeeping/status",
        "options": {}
      },
      "id": "get-bookkeeping-status",
      "name": "Get Bookkeeping Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        520,
        320
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "format-weekly-report-summary",
              "name": "summary",
              "value": "={{ { stage: 'weekly-report', status: $json.status ?? $json.data?.status ?? 'unknown', summary: $json.summary ?? $json.data?.summary ?? {}, missing: $json.missing ?? $json.data?.missing ?? [] } }}",
              "type": "object"
            },
            {
              "id": "format-weekly-report-report",
              "name": "report",
              "value": "={{ { status: $json.status ?? $json.data?.status ?? 'unknown', summary: $json.summary ?? $json.data?.summary ?? {}, missing: $json.missing ?? $json.data?.missing ?? [], checks: $json.checks ?? $json.data?.checks ?? [] } }}",
              "type": "object"
            },
            {
              "id": "format-weekly-report-source",
              "name": "source",
              "value": "n8n",
              "type": "string"
            },
            {
              "id": "format-weekly-report-timestamp",
              "name": "timestamp",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        }
      },
      "id": "format-weekly-report",
      "name": "Format Weekly Report",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        780,
        320
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const item = items[0]?.json ?? {};\nconst report = item.report ?? item.summary ?? {};\nconst summary = { ...(item.summary ?? {}), status: item.summary?.status ?? report.status ?? 'unknown' };\n\nreturn [{ json: { ...item, summary, report } }];"
      },
      "id": "temp-code-weekly",
      "name": "Normalize Weekly Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        320
      ]
    },
    {
      "parameters": {
        "fromEmail": "no-reply@brunella.local",
        "toEmail": "={{ $env.BOOKKEEPING_NOTIFY_EMAIL || 'konyveles@example.com' }}",
        "subject": "={{ '[Brunella] Weekly bookkeeping report - ' + $now.toFormat('yyyy-LL-dd') }}",
        "text": "={{ JSON.stringify({ summary: $json.summary, report: $json.report, timestamp: $json.timestamp, source: $json.source }, null, 2) }}",
        "options": {}
      },
      "id": "send-weekly-report-email",
      "name": "Send Weekly Report Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1040,
        320
      ]
    }
  ],
  "connections": {
    "Cron Trigger (Weekly)": {
      "main": [
        {
          "node": "Get Bookkeeping Status",
          "type": "main",
          "index": 0
        }
      ]
    },
    "Get Bookkeeping Status": {
      "main": [
        {
          "node": "Format Weekly Report",
          "type": "main",
          "index": 0
        }
      ]
    },
    "Format Weekly Report": {
      "main": [
        [
          {
            "node": "Normalize Weekly Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Weekly Report": {
      "main": [
        [
          {
            "node": "Send Weekly Report Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {},
  "staticData": null,
  "tags": [
