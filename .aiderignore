# .aiderignore - Protected Files for Aider AI Assistant

# === CRITICAL INFRASTRUCTURE (DO NOT MODIFY) ===
# These files are managed by ProjectConductor or require manual oversight

# Track management (ProjectConductor owns this)
conductor/tracks.md
conductor/workflow.md
conductor/project_state.json

# Agent work logs (each agent manages their own)
.ai/claude.md
.ai/gemini.md
.ai/cursor.md
.ai/copilot.md
.ai/FOSZAL.md

# Sensitive configuration
.env
.env.local
.env.production

# Agent registry (requires careful manual updates)
src/agents/registry.json

# Critical core infrastructure (complex state management)
src/core/modelRouter.ts
src/utils/d1Adapter.ts
src/agents/AgentManager.ts
src/core/checkpoint.ts
src/core/phoenixEventBus.ts

# Build artifacts and dependencies
build/
dist/
node_modules/
.venv/
myai/.venv/
myai/__pycache__/
*.pyc

# Generated files
coverage/
.vitest/
playwright-report/
test-results/

# Logs and temporary files
logs/
*.log
.DS_Store
Thumbs.db

# Lock files (managed by package managers)
package-lock.json
pnpm-lock.yaml
uv.lock

# Database files
*.db
*.sqlite
*.db-journal

# Secrets and credentials
*.key
*.pem
credentials/
secrets/

# === AIDER CAN MODIFY EVERYTHING ELSE ===
# Including:
# - New agent implementations (src/agents/*Agent.ts)
# - Test files (test/*.test.ts)
# - Utility functions (src/utils/* except protected ones)
# - Dashboard components (src/dashboard/components/)
# - API routes (src/server/routes/)
# - Python workers (myai/agents/*, myai/workers/*)
# - Documentation (docs/*, README.md)
