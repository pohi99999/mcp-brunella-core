        340,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Kinyerjük a Langflow válaszát (A markdown szöveget)\nconst ajanlatSzoveg = $input.item.json.outputs[0].outputs[0].results.message.data.text;\n\nreturn {\n  json: {\n    ugyfel_neve: $node[\"Webhook (Bejövő E-mail szimuláció)\"].json.body.nev,\n    ugyfel_email: $node[\"Webhook (Bejövő E-mail szimuláció)\"].json.body.email,\n    kimeneti_ajanlat: ajanlatSzoveg\n  }\n};"
      },
      "id": "18f50106-9ab8-466d-ad50-1af406e12365",
      "name": "Válasz Extrahálása",
