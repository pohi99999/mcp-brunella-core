      "parameters": {
        "jsCode": "// Mai munkaidő összesítő számítás\nconst records = $input.all();\nconst chatId = $('Telegram Trigger').item.json.message.chat.id;\nconst firstName = $('Telegram Trigger').item.json.message.chat.first_name || 'Dolgozó';\n\nlet totalRecords = records.length;\nlet message = `📊 **${firstName} - Mai munkaidő státusz:**\\n\\n`;\n\nif (totalRecords === 0) {\n  message += '❌ Ma még nincs rögzített munkaidő.\\n\\n';\n  message += '💡 Küldj egy üzenetet, például:\\n';\n  message += '• \"Ma 8 órát dolgoztam\"\\n';\n  message += '• \"Kezdtem 9:00\"';\n} else {\n  message += `✅ **${totalRecords}** bejegyzés rögzítve ma.\\n\\n`;\n  \n  records.forEach((record, index) => {\n    const datum = record.json.Dátum || 'N/A';\n    const megjegyzes = record.json.Megjegyzés || 'Nincs megjegyzés';\n    message += `${index + 1}. ${megjegyzes}\\n`;\n  });\n}\n\nreturn [{\n  json: {\n    message: message,\n    chatId: chatId,\n    totalRecords: totalRecords\n  }\n}];"
