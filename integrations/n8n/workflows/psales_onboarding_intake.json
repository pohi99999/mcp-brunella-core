    "Validate Input": {
      "main": [
        [
          {
            "node": "Forward to Brunella",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Forward to Brunella": {
      "main": [
        [
          {
            "node": "Confirmation Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
