    {
      "parameters": {
        "jsCode": "// Heti munkaid─╣ÔÇś ─é┬Âsszes─é┬şt─╣ÔÇś sz─é╦çm─é┬şt─é╦çs\nconst records = $input.all();\nconst chatId = $('Telegram Trigger').item.json.message.chat.id;\nconst firstName = $('Telegram Trigger').item.json.message.chat.first_name || 'Dolgoz─é┼é';\n\nlet totalRecords = records.length;\nlet message = `─Ĺ┼║ÔÇťÔÇŽ **${firstName} - Heti munkaid─╣ÔÇś ─é┬Âsszes─é┬şt─╣ÔÇś:**\\n\\n`;\n\nif (totalRecords === 0) {\n  message += '├ó┼ą┼Ü Az elm─é┼člt 7 napban nincs r─é┬Âgz─é┬ştett munkaid─╣ÔÇś.\\n';\n} else {\n  message += `├ó┼ŤÔÇŽ **${totalRecords}** bejegyz─é┬ęs az elm─é┼člt 7 napban.\\n\\n`;\n  \n  // D─é╦çtum szerint csoportos─é┬şt─é╦çs\n  const byDate = {};\n  records.forEach(record => {\n    const date = record.json.D─é╦çtum || 'Ismeretlen';\n    if (!byDate[date]) {\n      byDate[date] = [];\n    }\n    byDate[date].push(record.json.Megjegyz─é┬ęs || 'Nincs megjegyz─é┬ęs');\n  });\n  \n  // D─é╦çtum szerint rendez─é┬ęs\n  const sortedDates = Object.keys(byDate).sort().reverse();\n  \n  sortedDates.forEach(date => {\n    message += `\\n─Ĺ┼║ÔÇťÔÇá **${date}**\\n`;\n    byDate[date].forEach((megjegyzes, index) => {\n      message += `  ${index + 1}. ${megjegyzes}\\n`;\n    });\n  });\n}\n\nmessage += '\\n─Ĺ┼║ÔÇÖ╦ç Haszn─é╦çld a /statusz parancsot a mai st─é╦çtuszhoz.';\n\nreturn [{\n  json: {\n    message: message,\n    chatId: chatId,\n    totalRecords: totalRecords\n  }\n}];"
      },
