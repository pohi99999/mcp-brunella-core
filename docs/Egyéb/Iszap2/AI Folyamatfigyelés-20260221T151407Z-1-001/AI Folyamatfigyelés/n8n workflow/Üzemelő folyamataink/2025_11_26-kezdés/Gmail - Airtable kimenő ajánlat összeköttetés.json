    {
      "parameters": {
        "jsCode": "// Biztosítjuk, hogy a binary adat megfelelő formátumú legyen\nconst items = [];\n\nfor (const item of $input.all()) {\n  const newItem = {\n    json: item.json,\n    binary: {}\n  };\n  \n  // Végigmegyünk az összes binary adaton\n  for (const binaryKey in item.binary) {\n    const binaryData = item.binary[binaryKey];\n    \n    // Biztosítjuk, hogy a mimeType helyes legyen\n    newItem.binary[binaryKey] = {\n      ...binaryData,\n      mimeType: 'application/pdf', // Explicit beállítjuk\n      fileName: binaryData.fileName || 'document.pdf'\n    };\n  }\n  \n  items.push(newItem);\n}\n\nreturn items;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -464,
        704
      ],
      "id": "9c79aa71-f258-406c-8af1-453e1102daf7",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  // A bemeneti struktúra alapján a szöveg kinyerése\n  // A példád alapján: content tömb első elemének 'text' mezője\n  const rawText = item.json.content?.[0]?.text || item.json.text || \"\";\n\n  // Markdown kódblokk jelölők (```json és ```) eltávolítása regex segítségével\n  const cleanJsonString = rawText.replace(/```json\\s*|```/g, '').trim();\n\n  try {\n    // String konvertálása valódi JSON objektummá\n    const parsedData = JSON.parse(cleanJsonString);\n\n    // Visszatérés a tiszta adatstruktúrával\n    return {\n      json: parsedData\n    };\n\n  } catch (error) {\n    // Hibakezelés, ha az LLM nem valid JSON-t küldött\n    return {\n      json: {\n        error: \"JSON parse failed\",\n        message: error.message,\n        originalInput: rawText\n      }\n    };\n  }\n});"
      },
