[
  {
    "name": "github",
    "command": "npx",
    "args": ["-y", "@modelcontextprotocol/server-github"],
    "env": {
      "GITHUB_PERSONAL_ACCESS_TOKEN": "xxxxx"
    }
  },
  {
    "name": "brunella-core",
    "command": "node",
    "args": ["./build/index.js"]
  },
  {
    "name": "brunella-windows-manager",
    "command": "npx",
    "args": ["-y", "@simonb97/server-win-cli"],
    "env": {
      "ALLOWED_PATHS": [
        "C:\\Windows\\System32",
        "F:\\mcp-brunella-core",
        "G:\\Brunella",
        "C:\\Users\\pohi9"
      ]
    },
    "disabled": false
  },
  {
    "name": "playwright",
    "command": "npx",
    "args": ["-y", "@playwright/mcp@latest"]
  },
  {
    "name": "docker",
    "command": "npx",
    "args": ["-y", "@modelcontextprotocol/server-docker"],
    "disabled": true
  },
  {
    "name": "chrome-devtools",
    "command": "npx",
    "args": ["-y", "@modelcontextprotocol/server-puppeteer"]
  }
]
