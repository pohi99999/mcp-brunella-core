    warningErrors: warningErrors\n  }\n}];"},"name":"Hiba Statisztikák","type":"n8n-nodes-base.code","typeVersion":2,"position":[-720,-112],"id":"2404d6c9-1962-4610-9343-5d4c2f33f15f"},{"parameters":{"chatId":"7544590867","text":"={{ $json.message }}","additionalFields":{"parse_mode":"Markdown"}},"name":"Telegram - Heti Összesítő","type":"n8n-nodes-base.telegram","typeVersion":1,"position":[-496,-112],"id":"b63b7966-608c-4d4a-9673-463caa357a7f","webhookId":"f755356a-21c6-4b77-9377-24cc07c37c58","credentials":{"telegramApi":{"id":"lEp8aDHGJcOoUhAT","name":"Telegram account 4"}}}],"connections":{"Telegram Trigger":{"main":[[{"node":"Adat Előkészítés","type":"main","index":0}]]},"JSON Parser":{"main":[[{"node":"Kategória Router","type":"main","index":0}]]},"Kategória Router":{"main":[[{"node":"Airtable - Munkaidő","type":"main","index":0}],[{"node":"Airtable - Feladat","type":"main","index":0}],[{"node":"Válasz - Siker","type":"main","index":0}],[{"node":"Airtable - Költség","type":"main","index":0}]]},"Airtable - Munkaidő":{"main":[[{"node":"Válasz - Siker","type":"main","index":0}]]},"Airtable - Feladat":{"main":[[{"node":"Válasz - Siker","type":"main","index":0}]]},"Airtable - Költség":{"main":[[{"node":"Válasz - Siker","type":"main","index":0}]]},"Anthropic Chat Model":{"ai_languageModel":[[{"node":"Basic LLM Chain","type":"ai_languageModel","index":0}]]},"When chat message received":{"main":[[{"node":"Basic LLM Chain","type":"main","index":0}]]},"Webhook - Error Log":{"main":[[{"node":"Webhook Response","type":"main","index":0},{"node":"Error Formázás","type":"main","index":0}]]},"Error Formázás":{"main":[[{"node":"Airtable - Error Log","type":"main","index":0}]]},"Airtable - Error Log":{"main":[[{"node":"Kritikus Hiba?","type":"main","index":0}]]},"Kritikus Hiba?":{"main":[[{"node":"Telegram - Kritikus Hiba Értesítés","type":"main","index":0}]]},"Cron - Heti Összesítő":{"main":[[{"node":"Airtable - Heti Hibák","type":"main","index":0}]]},"Airtable - Heti Hibák":{