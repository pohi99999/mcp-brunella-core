ssage || 'Unknown error';\nconst severity = errorData.severity || 'error';\nconst executionId = errorData.execution_id || errorData.executionId || 'unknown';\nconst userId = errorData.user_id || errorData.userId || null;\n\nreturn [{\n  json: {\n    timestamp: timestamp,\n    workflow_id: workflowId,\n    node_name: nodeName,\n    error_message: errorMessage,\n    severity: severity,\n    execution_id: executionId,\n    user_id: userId,\n    raw_error: errorData\n  }\n}];"},"name":"Error Formázás","type":"n8n-nodes-base.code","typeVersion":2,"position":[-944,-336],"id":"c8e146cb-32e7-4574-b324-cc0f0acd8159"},{"parameters":{"operation":"create","application":{"__rl":true,"mode":"url","value":""},"table":"ERROR_LOG"},"name":"Airtable - Error Log","type":"n8n-nodes-base.airtable","typeVersion":1,"position":[-720,-336],"id":"0d909307-68ff-4352-ac78-7ec11ce70522","credentials":{"airtableTokenApi":{"id":"t3s4iIzriLpZ6Fm2","name":"Airtable Personal Access Token account"}}},{"parameters":{"conditions":{"options":{"caseSensitive":false,"leftValue":"","typeValidation":"strict"},"conditions":[{"id":"condition-1","leftValue":"={{ $json.severity }}","rightValue":"critical","operator":{"type":"string","operation":"equals"}}],"combinator":"and"},"options":{}},"name":"Kritikus Hiba?","type":"n8n-nodes-base.if","typeVersion":2,"position":[-496,-336],"id":"de7b616f-5c87-4489-bdb0-2f1667896f8f"},{"parameters":{"chatId":"7544590867","text":"🚨 **KRITIKUS HIBA ÉSZLELVE**\\n\\n**Workflow:** {{ $json.workflow_id }}\\n**Node:** {{ $json.node_name }}\\n**Hiba:** {{ $json.error_message }}\\n**Időpont:** {{ $json.timestamp }}\\n\\n⚠️ Azonnali beavatkozás szükséges!","additionalFields":{}},"name":"Telegram - Kritikus Hiba Értesítés","type":"n8n-nodes-base.telegram","typeVersion":1,"position":[-272,-336],"id":"c2d45cfb-3759-4480-918d-218b8a9a69fe","webhookId":"57f579b6-aa73-43f9-ba90-9c6a4c5c3b67","credentials":{"telegramApi":{"id":"lEp8aDHGJcOoUhAT","name":"Telegram account 4"}}},{"parameters":