# === BAS CORE SERVER ===
PORT=3000
NODE_ENV=development

# === OLLAMA (Local AI Engine) ===
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_MODEL_SECONDARY=llama3.1:8b
OLLAMA_MODEL_EMBEDDING=embeddinggemma:300m
# RAG dual-index embedding migration
RAG_EMBEDDING_MODEL_PRIMARY=mxbai-embed-large
RAG_EMBEDDING_DIM_PRIMARY=1024
RAG_EMBEDDING_MODEL_LEGACY=nomic-embed-text
RAG_EMBEDDING_DIM_LEGACY=768
RAG_DUAL_INDEX_WRITE=true
# OLLAMA_API_KEY=your_key_here

# === IRON CLAD BACKEND ===
IRON_CLAD_DEFAULT_MODEL=qwen2.5-coder:latest
IRON_CLAD_BACKEND_NAME=iron-clad-python-backend
VLLM_BASE_URL=http://localhost:8001
IRON_CLAD_HIGH_CAPACITY_MODELS=qwen2.5-72b-instruct
IRON_CLAD_GATEWAY_URL=http://127.0.0.1:8010
IRON_CLAD_INTERPRETER_ENABLED=false
IRON_CLAD_INTERPRETER_AUTO_RUN=false
IRON_CLAD_INTERPRETER_ALLOWED_MODES=python
IRON_CLAD_INTERPRETER_MAX_CHARS=4000
# IRON_CLAD_INTERPRETER_SYSTEM_MESSAGE=Extra system message here

# === OPENDEVIN ===
IRON_CLAD_OPENDEVIN_ENABLED=false
IRON_CLAD_OPENDEVIN_MODE=http
IRON_CLAD_OPENDEVIN_BASE_URL=http://127.0.0.1:8080
# IRON_CLAD_OPENDEVIN_CLI=python -m opendevin.cli
IRON_CLAD_OPENDEVIN_PROJECT_ROOT=.
IRON_CLAD_OPENDEVIN_MODEL_ENDPOINT=http://127.0.0.1:8010
IRON_CLAD_OPENDEVIN_TIMEOUT=300
IRON_CLAD_OPENDEVIN_MAX_CHARS=8000

# === ANYTHINGLLM (Knowledge Hub) ===
ANYTHINGLLM_EXE_PATH=C:\Program Files\AnythingLLM\AnythingLLM.exe
ANYTHINGLLM_BASE_URL=http://localhost:3001
ANYTHINGLLM_WORKSPACE=brunella_main
# ANYTHINGLLM_API_KEY=your_key_here

# === CLOUDFLARE — BAS Infrastruktúra ===
# Token szétválasztás: docs/cloudflare/TOKEN_SETUP.md
#
# BAS Workers token (Workers:Edit, KV:Edit, D1:Edit, R2:Edit)
CF_BAS_ACCOUNT_ID=your_bas_account_id_here
CF_BAS_API_TOKEN=your_bas_workers_token_here
#
# Legacy aliases (backward compat)
CF_ACCOUNT_ID=${CF_BAS_ACCOUNT_ID}
CF_TOKEN=${CF_BAS_API_TOKEN}
CF_API_TOKEN=${CF_BAS_API_TOKEN}
CLOUDFLARE_ACCOUNT_ID=${CF_BAS_ACCOUNT_ID}
CLOUDFLARE_API_TOKEN=${CF_BAS_API_TOKEN}
#
# R2 Storage
CF_R2_ACCESS_KEY_ID=your_key_id_here
CF_R2_SECRET_ACCESS_KEY=your_secret_here
S3_API=https://{your_bas_account_id}.r2.cloudflarestorage.com
#
CLOUDFLARE_WORKER_URL=https://brunella-core.your_subdomain.workers.dev
WAB_HEALTH_URL=http://127.0.0.1:3002

# === CLOUDFLARE WORKERS AI (Ingyenes LLM inferencia) ===
# Külön token, csak Workers AI:Read scope kell
CF_AI_API_TOKEN=your_cf_ai_token_here
AI_GATEWAY_ENABLED=false
# Cloudflare modellek (ingyenes edge inferencia):
CF_AI_SMART_MODEL=@cf/meta/llama-3.3-70b-instruct
CF_AI_FAST_MODEL=@cf/meta/llama-3.1-8b-instruct

# === EXTERNAL AI APIS ===
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=AIzaSy...
GOOGLE_API_KEY=AIzaSy...
OPENAI_API_KEY=sk-proj-...
CLAUDE_API_KEY=sk-ant-...
BROWSER_USE_API_KEY=bu_...

# === LLM PROVIDER (Which brain powers the agents?) ===
# LLM_PROVIDER=github    # → GPT-5 mini via GitHub Models (ingyenes Pro+-szal)
# LLM_PROVIDER=gemini    # → Google Gemini
# LLM_PROVIDER=ollama    # → Lokális Ollama (alapértelmezett)

# === GITHUB MODELS (Pro+ subscription) ===
# GITHUB_TOKEN=ghp_...  # Opcionális - ha nincs, `gh auth token`-t használjuk
GITHUB_MODELS_DEFAULT_MODEL=openai/gpt-5-mini

# === AUTOMATION (n8n & GitHub) ===
# N8N_API_KEY=your_key_here
N8N_BASE_URL=https://n8n-latest-fulv.onrender.com
N8N_WEBHOOK_URL=https://n8n-latest-fulv.onrender.com/
# GITHUB_PAT=github_pat_...

# === OBSERVABILITY ===
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=Brunella_Core
# LANGCHAIN_API_KEY=lsv2_pt_...

# === ROBOTKÉZ V2 (Agentic Browser) ===
# LIVE VIEW BEÁLLÍTÁSOK:
# - false = Látható böngésző ablak (HEADED MODE - fejlesztéshez ajánlott!)
# - true  = Háttérben fut, csak Dashboard Live View (gyorsabb)
ROBOTKEZ_HEADLESS=false
ROBOTKEZ_SAVE_SCREENSHOTS=true
ROBOTKEZ_VIEWPORT_WIDTH=1280
ROBOTKEZ_VIEWPORT_HEIGHT=720

# LLM PLANNER (Robotkez tervező modellje)
# Ha beállítod, felülírja a ModelRouter automatikus döntését:
# ROBOTKEZ_LLM_PROVIDER=cloudflare   # -> CF Workers AI (ingyenes, quota-mentes!)
# ROBOTKEZ_LLM_PROVIDER=gemini       # -> Gemini 2.0 Flash
# ROBOTKEZ_LLM_PROVIDER=ollama       # -> Lokális Ollama

# EV HUNTER LLM PROVIDER
# EV_HUNTER_LLM=cloudflare  # -> CF Workers AI (ingyenes!)
# EV_HUNTER_LLM=gemini      # -> Gemini 2.0 Flash
# EV_HUNTER_LLM=ollama      # -> Lokális Ollama (alapértelmezett)

# === GITHUB WEBHOOK INTEGRATION (Phase 3: Jules CI/CD) ===
# GitHub webhook secret for signature verification
# Generate: https://github.com/<owner>/<repo>/settings/hooks
# Secret: Random string, 32+ characters
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# GitHub token for API calls (PR creation, branch management)
# Generate: https://github.com/settings/tokens (classic or fine-grained)
# Scopes needed: repo, workflow
GITHUB_TOKEN=ghp_your_github_token_here

# Slack webhook for notifications (optional)
# Get URL from: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

LLM_PROVIDER=github

# === INVOICE AUTOMATION (Phase 2: Gmail Fallback) ===
# Számlázz.hu API credentials (primary source)
SZAMLAZZ_HU_API_KEY=your_szamlazz_api_key_here
SZAMLAZZ_HU_USERNAME=your_username
SZAMLAZZ_HU_PASSWORD=your_password

# Gmail fallback settings
GMAIL_INVOICE_SENDER=szamla@szamlazz.hu
GMAIL_INVOICE_DOWNLOAD_DIR=./data/invoices_gmail_fallback

# Google Sheets service account settings
GOOGLE_SHEETS_ID=your_google_sheet_id_here
GOOGLE_SHEETS_NAME=Invoices
GOOGLE_CREDENTIALS_FILE=./credentials/google-service-account.json
# Alternative to GOOGLE_CREDENTIALS_FILE: inject the full service-account JSON directly
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Or use Application Default Credentials:
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\outside\repo\service-account.json
# Legacy aliases kept for backward compatibility only:
# GOOGLE_SHEETS_CREDS=./credentials/google-service-account.json
# GOOGLE_CLOUD_CREDENTIALS_PATH=./credentials/google-service-account.json

# Google Workspace desktop OAuth settings (interactive CLI/tools)
# GOOGLE_WORKSPACE_CREDENTIALS_FILE=./credentials/google-oauth2-credentials.json
# GOOGLE_WORKSPACE_TOKEN_FILE=./credentials/google-token.json
# === E2B Sandbox (Secure Python Execution) ===
# Get API key from: https://e2b.dev
E2B_API_KEY=your_e2b_api_key_here
# Set to 'true' to route Python execution through E2B cloud sandbox
# instead of local FastAPI or subprocess (highest isolation)
E2B_ENABLED=false

# === APIFY (Professional Web Scraping) ===
# Get API token from: https://console.apify.com/account/integrations
# Free tier: $5 credit/month (Google Search, LinkedIn, e-commerce scraping)
APIFY_API_TOKEN=your-apify-token-here

# === SECURITY — KÖTELEZŐ PRODUCTION-BAN ===
# Ha ezek nincsenek beállítva production módban, a szerver hibával indul!

# PSales JWT aláíró kulcs (min. 32 véletlenszerű karakter)
# Generálás: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PSALES_JWT_SECRET=

# Távoli hozzáférés HMAC-SHA256 kulcs (min. 32 karakter)
REMOTE_AUTH_SECRET=

# Federation manifest signing secret (min. 32 karakter)
# Generálás: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MANIFEST_SIGNING_SECRET=

# Admin dashboard jelszó (VITE build-time változó)
VITE_ADMIN_PASSWORD=

# n8n admin jelszó (n8n-playwright-automation.js + fix_n8n_credentials.mjs)
N8N_PASSWORD=
