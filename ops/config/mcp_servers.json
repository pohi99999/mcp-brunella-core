[
  {
    "name": "brunella-core",
    "command": "node",
    "args": ["./build/index.js"],
    "description": "The primary BAS controller (Host)"
  },
  {
    "name": "brunella-remote",
    "description": "Remote Brunella FastMCP deployment",
    "disabled": false
  },
  {
    "name": "github",
    "command": "npx",
    "args": ["-y", "@modelcontextprotocol/server-github"],
    "env": {
      "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PAT}"
    }
  },
  {
    "name": "copilot",
    "command": "npx",
    "args": ["-y", "@aykahshi/copilot-mcp-server"],
    "env": {
      "GITHUB_TOKEN": "${COPILOT_PAT}"
    }
  },
  {
    "name": "windows-manager",
    "command": "npx",
    "args": ["-y", "@simonb97/server-win-cli"],
    "env": {
      "ALLOWED_PATHS": "C:\\Windows\\System32,F:\\mcp-brunella-core,G:\\Brunella,C:\\Users\\pohi9"
    }
  },
  {
    "name": "google-search",
    "command": "npx",
    "args": ["-y", "@modelcontextprotocol/server-google-search"],
    "env": {
      "GOOGLE_API_KEY": "${GOOGLE_API_KEY}",
      "GOOGLE_SEARCH_ENGINE_ID": "${GOOGLE_SEARCH_ENGINE_ID}"
    },
    "disabled": true
  },
  {
    "name": "brave-search",
    "command": "npx",
    "args": ["-y", "@modelcontextprotocol/server-brave-search"],
    "env": {
      "BRAVE_API_KEY": "${BRAVE_API_KEY}"
    },
    "disabled": true
  },
  {
    "name": "memory",
    "command": "npx",
    "args": ["-y", "@modelcontextprotocol/server-memory"],
    "env": {
      "MEMORY_FILE_PATH": "data/mcp_memory.json"
    }
  },
  {
    "name": "sqlite",
    "command": "npx",
    "args": ["-y", "@modelcontextprotocol/server-sqlite", "data/brunella.db"]
  },
  {
    "name": "n8n",
    "command": "npx",
    "args": ["-y", "@modelcontextprotocol/server-n8n"],
    "env": {
      "N8N_API_KEY": "${N8N_API_KEY}",
      "N8N_BASE_URL": "${N8N_BASE_URL}"
    }
  },
  {
    "name": "filesystem",
    "command": "npx",
    "args": [
      "-y",
      "@modelcontextprotocol/server-filesystem",
      "F:\\mcp-brunella-core",
      "G:\\Brunella"
    ]
  },
  {
    "name": "playwright",
    "command": "npx",
    "args": ["-y", "@playwright/mcp@latest"]
  },
  {
    "name": "brunella-python",
    "command": "python",
    "args": ["-m", "myai.mcp_server"],
    "env": {
      "PYTHONPATH": "."
    }
  }
]
