# === BAS CORE SERVER ===
PORT=3000
NODE_ENV=development

# === OLLAMA (Local AI Engine) ===
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_MODEL_SECONDARY=llama3.1:8b
OLLAMA_MODEL_EMBEDDING=embeddinggemma:300m
# RAG dual-index embedding migration
RAG_EMBEDDING_MODEL_PRIMARY=mxbai-embed-large
RAG_EMBEDDING_DIM_PRIMARY=1024
RAG_EMBEDDING_MODEL_LEGACY=nomic-embed-text
RAG_EMBEDDING_DIM_LEGACY=768
RAG_DUAL_INDEX_WRITE=true
# OLLAMA_API_KEY=your_key_here

# === IRON CLAD BACKEND ===
IRON_CLAD_DEFAULT_MODEL=qwen2.5-coder:latest
IRON_CLAD_BACKEND_NAME=iron-clad-python-backend
VLLM_BASE_URL=http://localhost:8001
IRON_CLAD_HIGH_CAPACITY_MODELS=qwen2.5-72b-instruct
IRON_CLAD_GATEWAY_URL=http://127.0.0.1:8010
IRON_CLAD_INTERPRETER_ENABLED=false
IRON_CLAD_INTERPRETER_AUTO_RUN=false
IRON_CLAD_INTERPRETER_ALLOWED_MODES=python
IRON_CLAD_INTERPRETER_MAX_CHARS=4000
# IRON_CLAD_INTERPRETER_SYSTEM_MESSAGE=Extra system message here

# === OPENDEVIN ===
IRON_CLAD_OPENDEVIN_ENABLED=false
IRON_CLAD_OPENDEVIN_MODE=http
IRON_CLAD_OPENDEVIN_BASE_URL=http://127.0.0.1:8080
# IRON_CLAD_OPENDEVIN_CLI=python -m opendevin.cli
IRON_CLAD_OPENDEVIN_PROJECT_ROOT=.
IRON_CLAD_OPENDEVIN_MODEL_ENDPOINT=http://127.0.0.1:8010
IRON_CLAD_OPENDEVIN_TIMEOUT=300
IRON_CLAD_OPENDEVIN_MAX_CHARS=8000

# === ANYTHINGLLM (Knowledge Hub) ===
ANYTHINGLLM_EXE_PATH=C:\Program Files\AnythingLLM\AnythingLLM.exe
ANYTHINGLLM_BASE_URL=http://localhost:3001
ANYTHINGLLM_WORKSPACE=brunella_main
# ANYTHINGLLM_API_KEY=your_key_here

# === CLOUD SERVICES (Cloudflare R2 & Workers) ===
CF_ACCOUNT_ID=your_id_here
CF_R2_ACCESS_KEY_ID=your_key_id_here
CF_R2_SECRET_ACCESS_KEY=your_secret_here
CF_TOKEN=your_token_here
S3_API=https://{your_id}.r2.cloudflarestorage.com

# === EXTERNAL AI APIS ===
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=AIzaSy...
GOOGLE_API_KEY=AIzaSy...
OPENAI_API_KEY=sk-proj-...
CLAUDE_API_KEY=sk-ant-...
BROWSER_USE_API_KEY=bu_...

# === LLM PROVIDER (Which brain powers the agents?) ===
# LLM_PROVIDER=github    # → GPT-4.1 via GitHub Models (ingyenes Pro+-szal)
# LLM_PROVIDER=gemini    # → Google Gemini
# LLM_PROVIDER=ollama    # → Lokális Ollama (alapértelmezett)

# === GITHUB MODELS (Pro+ subscription) ===
# GITHUB_TOKEN=ghp_...  # Opcionális - ha nincs, `gh auth token`-t használjuk
GITHUB_MODELS_DEFAULT_MODEL=openai/gpt-4.1

# === AUTOMATION (n8n & GitHub) ===
# N8N_API_KEY=your_key_here
N8N_BASE_URL=https://n8n-latest-fulv.onrender.com
N8N_WEBHOOK_URL=https://n8n-latest-fulv.onrender.com/
# GITHUB_PAT=github_pat_...

# === OBSERVABILITY ===
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=Brunella_Core
# LANGCHAIN_API_KEY=lsv2_pt_...

# === ROBOTKÉZ V2 (Agentic Browser) ===
# LIVE VIEW BEÁLLÍTÁSOK:
# - false = Látható böngésző ablak (HEADED MODE - fejlesztéshez ajánlott!)
# - true  = Háttérben fut, csak Dashboard Live View (gyorsabb)
ROBOTKEZ_HEADLESS=false
ROBOTKEZ_SAVE_SCREENSHOTS=true
ROBOTKEZ_VIEWPORT_WIDTH=1280
ROBOTKEZ_VIEWPORT_HEIGHT=720

LLM_PROVIDER=github