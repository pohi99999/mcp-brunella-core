    {
      "parameters": {
        "jsCode": "// Parse the AI Agent output JSON\nconst output = $input.first().json.output || $input.first().json.text || '';\nlet parsed;\ntry {\n  // Try to extract JSON from the output\n  const jsonMatch = output.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) {\n    parsed = JSON.parse(jsonMatch[0]);\n  } else {\n    parsed = { intent: 'ISMERETLEN', response: '❓ Feldolgozási hiba történt. Kérlek, próbáld újra.' };\n  }\n} catch (e) {\n  parsed = { intent: 'ISMERETLEN', response: '❓ Feldolgozási hiba történt. Kérlek, próbáld újra.' };\n}\n\n// Add metadata\nparsed.chat_id = $('Telegram Trigger').first().json.message.chat.id;\nparsed.raw_message = $('Telegram Trigger').first().json.message.text;\nparsed.munkatars_record_id = $('Munkatárs Keresése Chat ID alapján').first().json.id;\nparsed.munkatars_nev = $('Munkatárs Keresése Chat ID alapján').first().json.fields?.['Név'] || 'Ismeretlen';\n\nreturn [{ json: parsed }];"
      },
