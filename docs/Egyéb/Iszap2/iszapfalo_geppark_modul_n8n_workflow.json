      "typeVersion": 4.1,
      "position": [
        320,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Kiszedjük a Langflow által generált JSON stringet\nconst responseText = $input.item.json.outputs[0].outputs[0].results.message.data.text;\n\ntry {\n  // Megpróbáljuk JSON objektummá alakítani\n  const parsedData = JSON.parse(responseText);\n  \n  return {\n    json: {\n      status: \"success\",\n      adatok: parsedData\n    }\n  };\n} catch (error) {\n  // Ha nem sikerült (pl. nem tiszta JSON-t adott vissza az LLM)\n  return {\n    json: {\n      status: \"error\",\n      hiba: \"A Langflow nem érvényes JSON-t adott vissza.\",\n      nyers_valasz: responseText\n    }\n  };\n}"
      },
