m || 'Ismeretlen';\n    if (!byDate[date]) {\n      byDate[date] = [];\n    }\n    byDate[date].push(record.json.Megjegyzés || 'Nincs megjegyzés');\n  });\n  \n  // Dátum szerint rendezés\n  const sortedDates = Object.keys(byDate).sort().reverse();\n  \n  sortedDates.forEach(date => {\n    message += `\\n📆 **${date}**\\n`;\n    byDate[date].forEach((megjegyzes, index) => {\n      message += `  ${index + 1}. ${megjegyzes}\\n`;\n    });\n  });\n}\n\nmessage += '\\n💡 Használd a /statusz parancsot a mai státuszhoz.';\n\nreturn [{\n  json: {\n    message: message,\n    chatId: chatId,\n    totalRecords: totalRecords\n  }\n}];"},"name":"Heti Összesítő Számítás","type":"n8n-nodes-base.code","typeVersion":2,"position":[208,208],"id":"11a718d5-9fad-4d83-b296-e1855ae02f27"},{"parameters":{"chatId":"={{ $json.chatId }}","text":"={{ $json.message }}","additionalFields":{"parse_mode":"Markdown"}},"name":"Telegram - Státusz Válasz","type":"n8n-nodes-base.telegram","typeVersion":1,"position":[400,0],"id":"6950bf8b-7671-4711-92e5-b5a65add0257","webhookId":"ce9e9147-1586-4344-9956-f0639ac1cda9","credentials":{"telegramApi":{"id":"lEp8aDHGJcOoUhAT","name":"Telegram account 4"}}},{"parameters":{"chatId":"={{ $json.chatId }}","text":"={{ $json.message }}","additionalFields":{"parse_mode":"Markdown"}},"name":"Telegram - Heti Válasz","type":"n8n-nodes-base.telegram","typeVersion":1,"position":[400,208],"id":"971c01a2-5b6f-4860-995f-1ccfcf42ce3a","webhookId":"91b387c5-93f1-4a69-bffa-0c9bbac41b32","credentials":{"telegramApi":{"id":"lEp8aDHGJcOoUhAT","name":"Telegram account 4"}}}],"connections":{"Telegram Trigger":{"main":[[{"node":"Parancs Router","type":"main","index":0}]]},"Parancs Router":{"main":[[{"node":"Airtable - Mai Munkaidő","type":"main","index":0}],[{"node":"Airtable - Heti Munkaidő","type":"main","index":0}]]},"Airtable - Mai Munkaidő":{"main":[[{"node":"Státusz Számítás","type":"main","index":0}]]},"Státusz Számítás":{"main":[[{"node":"Telegram - Státusz Válasz","type":"mai