      {
        "parameters": {
          "jsCode": "// Heti hiba statisztikĂˇk szĂˇmĂ­tĂˇsa\nconst errors = $input.all();\n\nconst totalErrors = errors.length;\nconst criticalErrors = errors.filter(e => e.json.Severity === 'critical').length;\nconst errorErrors = errors.filter(e => e.json.Severity === 'error').length;\nconst warningErrors = errors.filter(e => e.json.Severity === 'warning').length;\n\n// Workflow szerint csoportosĂ­tĂˇs\nconst byWorkflow = {};\nerrors.forEach(error => {\n  const workflow = error.json['Workflow ID'] || 'unknown';\n  if (!byWorkflow[workflow]) {\n    byWorkflow[workflow] = 0;\n  }\n  byWorkflow[workflow]++;\n});\n\nlet message = `đź“Š **Heti Hiba Ă–sszesĂ­tĹ‘**\\n\\n`;\nmessage += `**Ă–sszes hiba:** ${totalErrors}\\n`;\nmessage += `â€˘ Kritikus: ${criticalErrors}\\n`;\nmessage += `â€˘ Hiba: ${errorErrors}\\n`;\nmessage += `â€˘ FigyelmeztetĂ©s: ${warningErrors}\\n\\n`;\n\nif (Object.keys(byWorkflow).length > 0) {\n  message += `**Workflow szerint:**\\n`;\n  Object.entries(byWorkflow).forEach(([workflow, count]) => {\n    message += `â€˘ ${workflow}: ${count}\\n`;\n  });\n}\n\nif (totalErrors === 0) {\n  message += '\\nâś… Nincs hiba az elmĂşlt hĂ©ten!';\n} else if (criticalErrors > 0) {\n  message += '\\nâš ď¸Ź **Figyelem:** Kritikus hibĂˇk Ă©szlelve!';\n}\n\nreturn [{\n  json: {\n    message: message,\n    totalErrors: totalErrors,\n    criticalErrors: criticalErrors,\n    errorErrors: errorErrors,\n    warningErrors: warningErrors\n  }\n}];"
        },
