{
	"servers": {
		"brunella": {
			"type": "http",
			"url": "http://localhost:3000/sse",
			"headers": {
				"x-api-key": "${input:BRUNELLA_API_KEY}"
			}
		},
		"brunella-remote": {
			"type": "http",
			"url": "https://Brunella-Agents-System-Server.fastmcp.app/mcp"
		},
		"io.github.ChromeDevTools/chrome-devtools-mcp": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"--registry",
				"https://registry.npmjs.org",
				"chrome-devtools-mcp@0.17.0"
			],
			"gallery": "https://api.mcp.github.com",
			"version": "0.17.0"
		},
		"io.github.wonderwhy-er/desktop-commander": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"--registry",
				"https://registry.npmjs.org",
				"@wonderwhy-er/desktop-commander@0.2.35"
			],
			"gallery": "https://api.mcp.github.com",
			"version": "0.2.35"
		},
		"io.github.upstash/context7": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"@upstash/context7-mcp@1.0.31"
			],
			"env": {
				"CONTEXT7_API_KEY": "${input:CONTEXT7_API_KEY}"
			},
			"gallery": "https://api.mcp.github.com",
			"version": "1.0.31"
		},
		"io.github.github/github-mcp-server": {
			"type": "stdio",
			"command": "docker",
			"args": [
				"run",
				"-i",
				"--rm",
				"-e",
				"GITHUB_PERSONAL_ACCESS_TOKEN=${input:github_token}",
				"ghcr.io/github/github-mcp-server:0.31.0"
			],
			"gallery": "https://api.mcp.github.com",
			"version": "0.31.0"
		},
		"io.github.vercel/next-devtools-mcp": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"next-devtools-mcp@0.3.6"
			],
			"gallery": "https://api.mcp.github.com",
			"version": "0.3.6"
		},
		"cloudflare": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"@cloudflare/mcp-server-cloudflare"
			],
			"env": {
				"CLOUDFLARE_ACCOUNT_ID": "${input:cloudflareBasAccountId}",
				"CLOUDFLARE_API_TOKEN": "${input:cloudflareBasApiToken}"
			}
		},
		"sqlite": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-sqlite",
				"data/brunella.db"
			],
			"disabled": true
		},
		"fetch": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-fetch"
			]
		},
		"memory": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-memory"
			],
			"env": {
				"MEMORY_FILE_PATH": "data/mcp_memory.json"
			}
		},
		"sequential-thinking": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-sequential-thinking"
			]
		},
		"filesystem": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-filesystem",
				"C:\\",
				"C:\\Users\\pohi9",
				"F:\\mcp-brunella-core"
			]
		},
		"csharp-mcp-server": {
			"type": "stdio",
			"command": "powershell.exe",
			"args": [
				"-NoLogo",
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"csharp-mcp-server\\launch.ps1"
			],
			"description": "Standalone C# MCP server with workspace file tools and review prompt",
			"platforms": [
				"win32"
			]
		},
		"workspace-mcp-server": {
			"type": "stdio",
			"command": "uv",
			"args": [
				"run",
				"--project",
				"workspace-mcp-server",
				"workspace-mcp-server",
				"--workspace-root",
				"."
			]
		},
		"microsoft/playwright-mcp": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"@playwright/mcp@latest"
			],
			"gallery": "https://api.mcp.github.com",
			"version": "0.0.1-seed"
		},
		"oraios/serena": {
			"type": "stdio",
			"command": "uvx",
			"args": [
				"--from",
				"git+https://github.com/oraios/serena",
				"serena",
				"start-mcp-server",
				"serena@latest",
				"--context",
				"ide-assistant"
			],
			"gallery": "https://api.mcp.github.com",
			"version": "1.0.0"
		},
		"io.github.microsoft/awesome-copilot": {
			"type": "stdio",
			"command": "docker",
			"args": [
				"run",
				"-i",
				"--rm",
				"ghcr.io/microsoft/mcp-dotnet-samples/awesome-copilot:1.0.2026041005"
			],
			"gallery": "https://api.mcp.github.com",
			"version": "1.0.2026041005"
		},
		"microsoft/fabric-rti-mcp": {
			"type": "stdio",
			"command": "uvx",
			"args": [
				"microsoft-fabric-rti-mcp@0.1.0"
			],
			"env": {
				"KUSTO_SERVICE_URI": "${input:kusto_service_uri}",
				"KUSTO_SERVICE_DEFAULT_DB": "${input:kusto_default_db}",
				"AZ_OPENAI_EMBEDDING_ENDPOINT": "${input:az_openai_embedding_endpoint}",
				"KUSTO_KNOWN_SERVICES": "${input:kusto_known_services_json}",
				"KUSTO_EAGER_CONNECT": "${input:kusto_eager_connect}",
				"KUSTO_ALLOW_UNKNOWN_SERVICES": "${input:kusto_allow_unknown_services}",
				"FABRIC_API_BASE": "${input:fabric_api_base}"
			},
			"gallery": "https://api.mcp.github.com",
			"version": "1.0.0"
		},
		"io.github.sourcegraph/mcp": {
			"type": "http",
			"url": "https://{sourcegraph_hostname}/.api/mcp",
			"gallery": "https://api.mcp.github.com",
			"version": "0.1.0"
		}
	},
	"inputs": [
		{
			"id": "github_token",
			"type": "promptString",
			"description": "GitHub Personal Access Token (repo/issues scope)",
			"password": true
		},
		{
			"id": "CONTEXT7_API_KEY",
			"type": "promptString",
			"description": "Context7 API key",
			"password": true
		},
		{
			"id": "cloudflareBasAccountId",
			"type": "promptString",
			"description": "BAS Cloudflare Account ID",
			"password": false
		},
		{
			"id": "cloudflareBasApiToken",
			"type": "promptString",
			"description": "BAS Cloudflare API Token (Workers/KV/D1/R2 permissions)",
			"password": true
		},
		{
			"id": "BRUNELLA_API_KEY",
			"type": "promptString",
			"description": "API key for local brunella MCP server (x-api-key header)",
			"password": true
		},
		{
			"id": "kusto_service_uri",
			"type": "promptString",
			"description": "Default Kusto cluster URI (e.g., https://help.kusto.windows.net/ or your cluster).",
			"password": false
		},
		{
			"id": "kusto_default_db",
			"type": "promptString",
			"description": "Default database name for Kusto queries (e.g., Samples).",
			"password": false
		},
		{
			"id": "az_openai_embedding_endpoint",
			"type": "promptString",
			"description": "Azure OpenAI embeddings endpoint for shots/semantic search (format: https://<resource>.openai.azure.com/openai/deployments/<name>/embeddings?api-version=<version>;impersonate).",
			"password": false
		},
		{
			"id": "kusto_known_services_json",
			"type": "promptString",
			"description": "JSON array of preconfigured Kusto services (e.g., [{\"service_uri\":\"https://cluster.kusto.windows.net\",\"default_database\":\"DB\"}]).",
			"password": false
		},
		{
			"id": "kusto_eager_connect",
			"type": "promptString",
			"description": "Whether to eagerly connect to the default service on startup (true/false).",
			"password": false
		},
		{
			"id": "kusto_allow_unknown_services",
			"type": "promptString",
			"description": "Allow connections to services not listed in KUSTO_KNOWN_SERVICES (true/false).",
			"password": false
		},
		{
			"id": "fabric_api_base",
			"type": "promptString",
			"description": "Base URL for Fabric APIs (default https://api.fabric.microsoft.com/v1).",
			"password": false
		}
	]
}
