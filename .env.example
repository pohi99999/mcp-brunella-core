# MCP Brunella Core Environment Variables
# Copy this file to .env and fill in your values

# Node Environment
NODE_ENV=production

# AnythingLLM Integration
ANYTHINGLLM_API_KEY=your_api_key_here
ANYTHINGLLM_API_URL=http://localhost:3001

# Google Workspace (if using Google tools)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama2

# Claude API (if using)
CLAUDE_API_KEY=

# System Monitoring
ENABLE_MONITORING=true
CPU_THRESHOLD=80
MEMORY_THRESHOLD=70

# Tool Paths (Windows specific - adjust for your system)
PROCESS_LASSO_PATH=C:\Tools\ProcessLasso\lasso.exe
CRYSTAL_DISK_INFO_PATH=C:\Tools\Disk\CrystalDiskInfo.exe
HWINFO_PATH=C:\Tools\HWiNFO\HWiNFO64.exe

# Logging
LOG_LEVEL=info
LOG_DIR=./logs
