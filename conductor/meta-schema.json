{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Conductor Track Meta Schema",
  "description": "Schema for conductor/tracks/*/meta.json files - Spec Freeze Protocol",
  "type": "object",
  "required": ["track_id", "status", "created_at"],
  "properties": {
    "track_id": {
      "type": "string",
      "description": "Unique identifier for the track (folder name)"
    },
    "title": {
      "type": "string",
      "description": "Human-readable title"
    },
    "description": {
      "type": "string",
      "description": "Brief description of the track"
    },
    "type": {
      "type": "string",
      "enum": ["feature", "bugfix", "refactor", "docs", "infrastructure"],
      "default": "feature"
    },
    "priority": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"],
      "default": "MEDIUM"
    },
    "status": {
      "type": "string",
      "enum": ["new", "pending", "in_progress", "testing", "completed", "archived"],
      "description": "Overall track status"
    },
    "spec_status": {
      "type": "string",
      "enum": ["draft", "review", "approved", "frozen"],
      "default": "draft",
      "description": "Spec Freeze Protocol: Implementation only allowed when 'frozen'"
    },
    "spec_approved_at": {
      "type": "string",
      "format": "date-time",
      "description": "When spec was approved/frozen"
    },
    "spec_approved_by": {
      "type": "string",
      "description": "Agent or person who approved the spec"
    },
    "implementation_allowed": {
      "type": "boolean",
      "default": false,
      "description": "True only when spec_status is 'frozen'"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string"
    },
    "completed_at": {
      "type": "string"
    },
    "archived_at": {
      "type": "string",
      "format": "date-time"
    },
    "archivedAt": {
      "type": "string"
    },
    "archive_reason": {
      "type": "string"
    },
    "archiveReason": {
      "type": "string"
    },
    "supersededByTracks": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "Optional for archived predecessor tracks that are explicitly replaced by later validated work."
    },
    "superseded_by_tracks": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "verified": {
      "type": "boolean"
    },
    "verifiedAt": {
      "type": "string"
    },
    "verificationNotes": {
      "type": "string"
    },
    "verification_notes": {
      "type": "string"
    },
    "assigned_agent": {
      "type": "string",
      "description": "Primary agent responsible"
    },
    "progress": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "default": 0
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Other track IDs this depends on"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "dod": {
      "type": "object",
      "required": ["tests_pass", "build_clean", "code_committed", "no_verify_used"],
      "additionalProperties": false,
      "properties": {
        "tests_pass": {
          "type": "boolean"
        },
        "build_clean": {
          "type": "boolean"
        },
        "code_committed": {
          "type": "boolean"
        },
        "no_verify_used": {
          "type": "boolean",
          "description": "Must remain false. True means a forbidden --no-verify bypass occurred."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": { "const": "completed" }
        }
      },
      "then": {
        "required": ["dod", "verificationNotes", "completedAt"],
        "properties": {
          "progress": { "const": 100 },
          "dod": {
            "properties": {
              "tests_pass": { "const": true },
              "build_clean": { "const": true },
              "code_committed": { "const": true },
              "no_verify_used": { "const": false }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "archived" }
        }
      },
      "then": {
        "required": ["archiveReason", "archivedAt"],
        "anyOf": [
          {
            "required": ["dod"],
            "properties": {
              "progress": { "const": 100 },
              "dod": {
                "properties": {
                  "tests_pass": { "const": true },
                  "build_clean": { "const": true },
                  "code_committed": { "const": true },
                  "no_verify_used": { "const": false }
                }
              }
            }
          },
          {
            "anyOf": [
              { "required": ["supersededByTracks"] },
              { "required": ["superseded_by_tracks"] }
            ]
          }
        ]
      }
    }
  ]
}
