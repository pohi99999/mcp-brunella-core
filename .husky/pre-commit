# Keep generated BOOTSTRAP copies synced before lint/build validation.
npx tsx ops/scripts/sync_bootstrap.ts --stage || exit 1

# EPP v2: Check for active track before committing code
npx tsx ops/scripts/sync/precommit-track-guard.mts || exit 1

# Pre-commit: build + lint staged code files
# Repo-wide lint is noisy while the autofix branch is in progress.
npm run build || exit 1
node ops/scripts/check-active-track.mjs || exit 1
node ops/scripts/validate-track-dod.mjs --staged || exit 1
node ops/scripts/precommit-lint.mjs || exit 1
node ops/scripts/hook-proof.mjs pre-commit || exit 1
