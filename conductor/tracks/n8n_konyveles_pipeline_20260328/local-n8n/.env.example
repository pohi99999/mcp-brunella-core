# Local n8n runtime for the bookkeeping track
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
N8N_USER_FOLDER=.n8n
N8N_SECURE_COOKIE=false
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_LOG_LEVEL=info

# Local login used by the editor and by the shared BAS docs/tests
N8N_TEST_URL=http://localhost:5678
N8N_TEST_USER=dev@localhost.com
N8N_TEST_PASSWORD=ChangeMe2026!

# Basic auth for the local editor
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=dev@localhost.com
N8N_BASIC_AUTH_PASSWORD=ChangeMe2026!

# Needed later if you want to use the API from BAS helpers
N8N_API_KEY=

# Required by n8n to encrypt credentials
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
