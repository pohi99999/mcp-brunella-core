      "parameters": {
        "jsCode": "// Csak azokat az emaileket engedi tovább, amiknek van csatolmánya\nconst itemsWithAttachments = [];\n\nfor (const item of $input.all()) {\n  // Debug: nézzük meg mi van a binary-ban\n  console.log('Item binary keys:', item.binary ? Object.keys(item.binary) : 'NO BINARY');\n  \n  // Ellenőrizzük, hogy van-e binary adat (attachment)\n  if (item.binary && Object.keys(item.binary).length > 0) {\n    itemsWithAttachments.push(item);\n  }\n}\n\nreturn itemsWithAttachments;"
