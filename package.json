{
  "name": "mcp-brunella-core",
  "version": "1.0.0",
  "description": "MCP server for Brunella Core",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "brunella": "./build/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "node --loader ts-node/esm src/index.ts",
    "watch": "tsc -w",
    "smoke": "node scripts/smoke.mjs",
    "test:build": "tsc test/core_tools.test.ts test/monitor.test.ts test/python_shell.test.ts --outDir test_build --moduleResolution node --target es2020 --module commonjs --esModuleInterop",
    "test:run": "node --test test_build/*.test.js",
    "test:e2e": "node --loader ts-node/esm scripts/e2e_runner.ts",
    "test:cli": "node --loader ts-node/esm scripts/test_cli.ts",
    "test:unit:cli": "node --loader ts-node/esm test/cli_unit.test.ts",
    "test:factory": "node --loader ts-node/esm test/agent_factory.test.ts",
    "cli": "node build/cli/index.js",
    "test": "npm run test:build && npm run test:run",
    "build:ui": "vite build src/dashboard",
    "dev:ui": "vite src/dashboard"
  },
  "keywords": [
    "mcp",
    "brunella"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
