FROM node:24-alpine AS build

WORKDIR /app

COPY package*.json ./

# The repo's lockfile currently resolves cleanly with the local toolchain,
# but npm 11 in the container is stricter about peer conflicts.
RUN npm ci --legacy-peer-deps

COPY . .

RUN npx vite build --config vite.p-sales.config.ts

FROM nginx:1.29-alpine

COPY nginx.p-sales.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build/p-sales-standalone /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
