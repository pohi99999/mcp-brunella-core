      "parameters": {
        "jsCode": "// Error adatok formĂˇzĂˇsa Ă©s strukturĂˇlĂˇsa\nconst errorData = $input.item.json;\n\nconst timestamp = new Date().toISOString();\nconst workflowId = errorData.workflow_id || errorData.workflowId || 'unknown';\nconst nodeName = errorData.node_name || errorData.nodeName || 'unknown';\nconst errorMessage = errorData.error_message || errorData.errorMessage || errorData.message || 'Unknown error';\nconst severity = errorData.severity || 'error';\nconst executionId = errorData.execution_id || errorData.executionId || 'unknown';\nconst userId = errorData.user_id || errorData.userId || null;\n\nreturn [{\n  json: {\n    timestamp: timestamp,\n    workflow_id: workflowId,\n    node_name: nodeName,\n    error_message: errorMessage,\n    severity: severity,\n    execution_id: executionId,\n    user_id: userId,\n    raw_error: errorData\n  }\n}];"
