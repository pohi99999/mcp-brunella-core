{
  "name": "mcp-brunella-core",
  "version": "2.4.0",
  "description": "MCP server for Brunella Core",
  "type": "module",
  "main": "build/apps/mcp-core/index.js",
  "bin": {
    "brunella": "build/apps/mcp-core/cli.js",
    "brunella-jules": "build/apps/mcp-core/cli-jules-interactive.js",
    "brunella-hu": "build/apps/mcp-core/cli-hu.js"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "imports": {
    "@packages/*": "./packages/*"
  },
  "scripts": {
    "build:raw": "tsc && node -e \"const fs=require('fs');fs.mkdirSync('build/packages/agents',{recursive:true});fs.copyFileSync('packages/agents/registry.json','build/packages/agents/registry.json');fs.cpSync('build/packages/agents','build/agents',{recursive:true});console.log('registry.json copied to build/agents/ and build/packages/agents/');fs.mkdirSync('build/packages/utils/data',{recursive:true});fs.copyFileSync('packages/utils/data/triz_matrix.json','build/packages/utils/data/triz_matrix.json');fs.copyFileSync('packages/utils/data/triz_principles.json','build/packages/utils/data/triz_principles.json');console.log('TRIZ data copied');fs.mkdirSync('build/node_modules/@packages/utils',{recursive:true});fs.writeFileSync('build/node_modules/@packages/utils/pathResolver.js',\\\"export * from '../../../packages/utils/pathResolver.js';\\\");console.log('pathResolver alias stub copied');\"",
    "build": "npm run build:raw && node ops/scripts/hook-proof.mjs mark-build",
    "build:stable": "npm run build && npm run build:ui",
    "sync:bootstrap": "tsx ops/scripts/sync_bootstrap.ts",
    "sync:doc-stats": "tsx ops/scripts/sync_doc_stats.ts",
    "sync:doc-stats:check": "tsx ops/scripts/sync_doc_stats.ts --dry-run --fail-on-drift",
    "sync:docs": "tsx ops/scripts/sync_docs.ts",
    "sync:docs:check": "tsx ops/scripts/sync_docs.ts --dry-run --fail-on-drift",
    "agent:health": "tsx ops/scripts/agent_health_check.ts",
    "mcp:sync": "node ops/scripts/sync_mcp_config.js",
    "mcp:validate": "node ops/scripts/validate_mcp_config.js",
    "start": "npm run start:stable",
    "start:stable": "node --max-old-space-size=1536 ops/scripts/start-stable.mjs",
    "start:python:stable": "cd packages/myai && uv run uvicorn server:app --host 0.0.0.0 --port 8000",
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=6144 tsx apps/mcp-core/index.ts",
    "watch": "tsc -w",
    "smoke": "tsx ops/scripts/startup_smoke_test.ts",
    "mcp:run": "npm run start:stable",
    "cli:run": "node build/apps/mcp-core/cli.js",
    "cli": "node build/apps/mcp-core/cli.js",
    "cli:hu": "node build/apps/mcp-core/cli-hu.js",
    "test": "npm run build && vitest run",
    "test:fast:raw": "npm run build && vitest run --reporter=dot --exclude 'tests/test/cli-e2e*' --exclude 'tests/test/cli-phase*' --exclude 'tests/test/phase*' --exclude 'tests/test/swarm_smoke*' --exclude 'tests/test/robotkez_integration.test.ts' --exclude 'tests/test/lint_fixer.test.ts' --exclude 'tests/test/core_tools.test.ts'",
    "test:fast": "npm run test:fast:raw && node ops/scripts/hook-proof.mjs mark-testfast",
    "test:nightly": "npm run build && vitest run",
    "lint": "eslint apps/ packages/ tests/test/ ",
    "lint:fix": "eslint apps/ packages/ tests/test/ --fix",
    "test:watch": "vitest",
    "test:master": "vitest run --config vitest.master.config.ts",
    "test:master:watch": "vitest --config vitest.master.config.ts",
    "test:master:coverage": "vitest run --config vitest.master.config.ts --coverage",
    "test:coverage": "vitest run --coverage",
    "test:legacy": "node ops/scripts/test_prepare.cjs && node --test test_build/core_tools.test.js",
    "test:python": "node --loader ts-node/esm --test tests/test/python_shell.test.ts",
    "test:integration": "node ops/scripts/run-integration-tests.mjs",
    "test:vitest": "vitest run",
    "test:comprehensive": "vitest run tests/test/llm_client.test.ts tests/test/DeveloperAgent.test.ts",
    "test:all": "npm run test:unit:cli && npm run test:factory && npm run test:cli && npm test",
    "build:ui": "vite build apps/dashboard --config vite.config.ts",
    "build:overlay": "vite build -c vite.overlay.config.ts",
    "dev:ui": "vite apps/dashboard",
    "tauri": "npx @tauri-apps/cli",
    "desktop:dev": "npx @tauri-apps/cli dev",
    "desktop:build": "npx @tauri-apps/cli build",
    "dev:vscode": "code-server --bind-addr 127.0.0.1:8080 --auth none --disable-telemetry .",
    "test:dashboard": "vitest run --config vitest.dashboard.config.ts",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:health": "npx tsx ops/scripts/health_check.ts",
    "health": "npm run test:health",
    "services:install:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File ops/scripts\\supervisors\\windows\\install-windows-services.ps1",
    "services:install:linux": "bash ops/scripts/supervisors/linux/install-systemd-services.sh",
    "services:preflight": "node ops/scripts/service-preflight.mjs",
    "services:status:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File ops/scripts\\supervisors\\windows\\status-windows-services.ps1",
    "services:status:linux": "bash ops/scripts/supervisors/linux/status-systemd-services.sh",
    "services:uninstall:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File ops/scripts\\supervisors\\windows\\uninstall-windows-services.ps1",
    "services:uninstall:linux": "bash ops/scripts/supervisors/linux/uninstall-systemd-services.sh",
    "test:phoenix": "vitest run tests/test/state_restoration.test.ts",
    "test:full": "npm run build && vitest run && npm run test:health",
    "genkit:dev": "npx tsx --watch apps/mcp-core/genkit-flow.ts",
    "migrate:dry": "npx tsx ops/scripts/migrate-embeddings.ts --dry-run",
    "migrate:backup": "npx tsx ops/scripts/migrate-embeddings.ts --backup",
    "migrate": "npx tsx ops/scripts/migrate-embeddings.ts",
    "prepare": "husky",
    "sync:tracks": "node ./ops/scripts/export_tracks_to_sheet.js",
    "track:audit": "node ops/scripts/auditCompletedTracks.mjs",
    "track:validate:dod": "node ops/scripts/validate-track-dod.mjs --staged",
    "cf:rotate-secrets": "tsx ops/scripts/rotate-cloudflare-secrets.ts"
  },
