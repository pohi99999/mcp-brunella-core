{
  "mcpServers": {
    "brunella-core": {
      "command": "node",
      "args": [
        "${workspaceFolder}/build/index.js"
      ],
      "env": {
        "NODE_ENV": "development",
        "MCP_DEBUG": "true"
      },
      "notes": "A BAS Központi Agya (Orchestrator)"
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-playwright"
      ],
      "notes": "ROBOTKÉZ: Böngésző vezérlés és kattintás"
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${workspaceFolder}"
      ],
      "notes": "Biztonságos fájl hozzáférés a projekthez"
    },
    "git": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-git"
      ],
      "notes": "Verziókezelés"
    },
    "github-chat": {
      "command": "uvx",
      "args": [
        "github-chat-mcp"
      ],
      "notes": "A te GitHub Chat integrációd"
    }
  }
}