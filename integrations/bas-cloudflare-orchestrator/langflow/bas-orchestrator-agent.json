{
  "id": "bas-orchestrator-flow",
  "name": "BAS Multi-Agent Orchestrator",
  "description": "Decomposes complex tasks into subtasks and coordinates multiple agents",
  "data": {
    "nodes": [
      {
        "id": "ChatInput-Main",
        "type": "ChatInput",
        "position": { "x": 100, "y": 300 },
        "data": {
          "id": "ChatInput-Main",
          "node": {
            "template": {
              "input_value": {
                "type": "str",
                "required": true,
                "display_name": "Complex Task",
                "info": "A complex task that needs to be broken down and orchestrated"
              }
            }
          }
        }
      },
      {
        "id": "Prompt-TaskDecomposer",
        "type": "Prompt",
        "position": { "x": 350, "y": 300 },
        "data": {
          "id": "Prompt-TaskDecomposer",
          "node": {
            "template": {
              "template": {
                "value": "Te a BAS (Brunella Agent System) Task Decomposer modulja vagy.\n\n## Komplex feladat:\n{task}\n\n## Elérhető ügynökök:\n1. **ResearchAgent** - Információgyűjtés, web keresés, szintetizálás\n2. **CodeAgent** - Kód generálás, review, debug\n3. **BrowserAgent** - Web automatizálás, form kitöltés, scraping\n4. **DocumentAgent** - Dokumentum létrehozás, szerkesztés (Google Docs)\n5. **DataAgent** - Adat feldolgozás, elemzés, vizualizáció\n\n## Feladatod:\nBontsd fel a komplex feladatot végrehajtható részfeladatokra.\n\n## Válasz formátum (SZIGORÚAN JSON):\n```json\n{{\n  \"analysis\": \"Rövid elemzés a feladatról\",\n  \"subtasks\": [\n    {{\n      \"id\": 1,\n      \"agent\": \"ResearchAgent\",\n      \"action\": \"Konkrét utasítás az ügynöknek\",\n      \"dependencies\": [],\n      \"priority\": \"high/medium/low\",\n      \"estimated_time\": \"X perc\"\n    }},\n    {{\n      \"id\": 2,\n      \"agent\": \"CodeAgent\",\n      \"action\": \"Másik utasítás\",\n      \"dependencies\": [1],\n      \"priority\": \"medium\",\n      \"estimated_time\": \"Y perc\"\n    }}\n  ],\n  \"execution_order\": [1, 2],\n  \"total_estimated_time\": \"Z perc\",\n  \"risks\": [\"Potenciális kockázat 1\"]\n}}\n```"
              }
            }
          }
        }
      },
      {
        "id": "OllamaModel-Decomposer",
        "type": "OllamaModel",
        "position": { "x": 600, "y": 300 },
        "data": {
          "id": "OllamaModel-Decomposer",
          "node": {
            "template": {
              "model_name": { "value": "llama3.1:8b" },
              "base_url": { "value": "http://localhost:11434" },
              "temperature": { "value": 0.2 },
              "num_ctx": { "value": 4096 }
            }
          }
        }
      },
      {
        "id": "JSONParser-1",
        "type": "ParseData",
        "position": { "x": 850, "y": 300 },
        "data": {
          "id": "JSONParser-1",
          "node": {
            "template": {
              "sep": { "value": "\n" }
            }
          },
          "description": "Parse the JSON task decomposition"
        }
      },
      {
        "id": "ConditionalRouter-1",
        "type": "ConditionalRouter",
        "position": { "x": 1100, "y": 200 },
        "data": {
          "id": "ConditionalRouter-1",
          "node": {
            "template": {
              "conditions": {
                "value": [
                  { "condition": "agent == 'ResearchAgent'", "output": "research" },
                  { "condition": "agent == 'CodeAgent'", "output": "code" },
                  { "condition": "agent == 'BrowserAgent'", "output": "browser" },
                  { "condition": "agent == 'DocumentAgent'", "output": "document" },
                  { "condition": "agent == 'DataAgent'", "output": "data" }
                ]
              }
            }
          }
        }
      },
      {
        "id": "APIRequest-Research",
        "type": "APIRequest",
        "position": { "x": 1350, "y": 100 },
        "data": {
          "id": "APIRequest-Research",
          "node": {
            "template": {
              "url": { "value": "http://localhost:7860/api/v1/run/bas-research" },
              "method": { "value": "POST" },
              "headers": { "value": { "Content-Type": "application/json" } }
            }
          }
        }
      },
      {
        "id": "APIRequest-Code",
        "type": "APIRequest",
        "position": { "x": 1350, "y": 200 },
        "data": {
          "id": "APIRequest-Code",
          "node": {
            "template": {
              "url": { "value": "http://localhost:11434/api/generate" },
              "method": { "value": "POST" },
              "headers": { "value": { "Content-Type": "application/json" } },
              "body": { "value": "{ \"model\": \"llama3.1:8b\", \"prompt\": \"{action}\" }" }
            }
          }
        }
      },
      {
        "id": "APIRequest-Browser",
        "type": "APIRequest",
        "position": { "x": 1350, "y": 300 },
        "data": {
          "id": "APIRequest-Browser",
          "node": {
            "template": {
              "url": { "value": "http://localhost:8000/api/task" },
              "method": { "value": "POST" },
              "headers": { "value": { "Content-Type": "application/json" } }
            }
          },
          "description": "Send to Browser-Use API (robotkéz)"
        }
      },
      {
        "id": "APIRequest-Document",
        "type": "APIRequest",
        "position": { "x": 1350, "y": 400 },
        "data": {
          "id": "APIRequest-Document",
          "node": {
            "template": {
              "url": { "value": "http://localhost:5678/webhook/bas-document" },
              "method": { "value": "POST" }
            }
          },
          "description": "Send to n8n for Google Docs operations"
        }
      },
      {
        "id": "Prompt-ResultAggregator",
        "type": "Prompt",
        "position": { "x": 1600, "y": 300 },
        "data": {
          "id": "Prompt-ResultAggregator",
          "node": {
            "template": {
              "template": {
                "value": "Te a BAS Result Aggregator vagy.\n\n## Eredeti feladat:\n{original_task}\n\n## Részfeladat eredmények:\n{subtask_results}\n\n## Feladatod:\n1. Összesítsd az eredményeket\n2. Ellenőrizd, hogy minden részfeladat sikeres volt-e\n3. Készíts végső jelentést\n\n## Válasz formátum:\n### Státusz: [SIKERES/RÉSZLEGES/SIKERTELEN]\n\n### Összefoglaló\n[Mi történt]\n\n### Részletes eredmények\n[Részfeladatonként]\n\n### Következő lépések\n[Ha vannak]"
              }
            }
          }
        }
      },
      {
        "id": "OllamaModel-Aggregator",
        "type": "OllamaModel",
        "position": { "x": 1850, "y": 300 },
        "data": {
          "id": "OllamaModel-Aggregator",
          "node": {
            "template": {
              "model_name": { "value": "llama3.1:8b" },
              "base_url": { "value": "http://localhost:11434" },
              "temperature": { "value": 0.3 }
            }
          }
        }
      },
      {
        "id": "ChatOutput-Final",
        "type": "ChatOutput",
        "position": { "x": 2100, "y": 300 },
        "data": {
          "id": "ChatOutput-Final",
          "node": {
            "template": {
              "input_value": { "type": "str" }
            }
          }
        }
      }
    ],
    "edges": [
      { "source": "ChatInput-Main", "target": "Prompt-TaskDecomposer", "sourceHandle": "output", "targetHandle": "task" },
      { "source": "Prompt-TaskDecomposer", "target": "OllamaModel-Decomposer", "sourceHandle": "prompt", "targetHandle": "input" },
      { "source": "OllamaModel-Decomposer", "target": "JSONParser-1", "sourceHandle": "output", "targetHandle": "input" },
      { "source": "JSONParser-1", "target": "ConditionalRouter-1", "sourceHandle": "data", "targetHandle": "input" },
      { "source": "ConditionalRouter-1", "target": "APIRequest-Research", "sourceHandle": "research", "targetHandle": "input" },
      { "source": "ConditionalRouter-1", "target": "APIRequest-Code", "sourceHandle": "code", "targetHandle": "input" },
      { "source": "ConditionalRouter-1", "target": "APIRequest-Browser", "sourceHandle": "browser", "targetHandle": "input" },
      { "source": "ConditionalRouter-1", "target": "APIRequest-Document", "sourceHandle": "document", "targetHandle": "input" },
      { "source": "ChatInput-Main", "target": "Prompt-ResultAggregator", "sourceHandle": "output", "targetHandle": "original_task" },
      { "source": "APIRequest-Research", "target": "Prompt-ResultAggregator", "sourceHandle": "response", "targetHandle": "subtask_results" },
      { "source": "APIRequest-Code", "target": "Prompt-ResultAggregator", "sourceHandle": "response", "targetHandle": "subtask_results" },
      { "source": "APIRequest-Browser", "target": "Prompt-ResultAggregator", "sourceHandle": "response", "targetHandle": "subtask_results" },
      { "source": "Prompt-ResultAggregator", "target": "OllamaModel-Aggregator", "sourceHandle": "prompt", "targetHandle": "input" },
      { "source": "OllamaModel-Aggregator", "target": "ChatOutput-Final", "sourceHandle": "output", "targetHandle": "input" }
    ]
  },
  "endpoint_name": "bas-orchestrator",
  "is_component": false
}
