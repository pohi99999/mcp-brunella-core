{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": [
    "eslint:recommended"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": "off",
    "no-console": "off",
    "no-undef": "off"
  },
  "overrides": [
    {
      "files": ["test/**/*.ts", "test/**/*.tsx", "test/**/*.js"],
      "env": {
        "vitest": true
      },
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
