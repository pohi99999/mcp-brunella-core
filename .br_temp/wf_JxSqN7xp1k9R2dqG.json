    {
      "parameters": {
        "jsCode": "// Mai munkaidĹ‘ Ă¶sszesĂ­tĹ‘ szĂˇmĂ­tĂˇs\nconst records = $input.all();\nconst chatId = $('Telegram Trigger').item.json.message.chat.id;\nconst firstName = $('Telegram Trigger').item.json.message.chat.first_name || 'DolgozĂł';\n\nlet totalRecords = records.length;\nlet message = `đź“Š **${firstName} - Mai munkaidĹ‘ stĂˇtusz:**\\n\\n`;\n\nif (totalRecords === 0) {\n  message += 'âťŚ Ma mĂ©g nincs rĂ¶gzĂ­tett munkaidĹ‘.\\n\\n';\n  message += 'đź’ˇ KĂĽldj egy ĂĽzenetet, pĂ©ldĂˇul:\\n';\n  message += 'â€˘ \"Ma 8 ĂłrĂˇt dolgoztam\"\\n';\n  message += 'â€˘ \"Kezdtem 9:00\"';\n} else {\n  message += `âś… **${totalRecords}** bejegyzĂ©s rĂ¶gzĂ­tve ma.\\n\\n`;\n  \n  records.forEach((record, index) => {\n    const datum = record.json.DĂˇtum || 'N/A';\n    const megjegyzes = record.json.MegjegyzĂ©s || 'Nincs megjegyzĂ©s';\n    message += `${index + 1}. ${megjegyzes}\\n`;\n  });\n}\n\nreturn [{\n  json: {\n    message: message,\n    chatId: chatId,\n    totalRecords: totalRecords\n  }\n}];"
      },
