        320
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const input = items[0]?.json ?? {};\nconst timestamp = new Date().toISOString();\n\nreturn [{\n  json: {\n    ...input,\n    source: 'n8n',\n    stage: 'nav-validation-live',\n    timestamp,\n    invoice: input.invoice ?? input,\n  },\n}];"
      },
      "id": "normalize-nav-input",
      "name": "Normalize Invoice Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        320
      ]
    },
    {
      "parameters": {
        "method": "POST",
