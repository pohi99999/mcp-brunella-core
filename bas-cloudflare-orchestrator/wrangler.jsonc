{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bas-orchestrator",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "BAS_TASKS",
      "id": "b6718ab359ac401bb24da7c34c24f11b"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2_KNOWLEDGE",
      "bucket_name": "vodor1"
    }
  ],
  "d1_databases": [
    {
      "binding": "D1_METADATA",
      "database_name": "bas-metadata",
      "database_id": "8efce5d3-bcfc-4188-ac36-29db5bdf49fb"
    }
  ],
  "assets": {
    "directory": "../build/public",
    "binding": "ASSETS"
  },
  "vars": {
    "N8N_WEBHOOK_URL": "http://localhost:5678/webhook/bas-task",
    "BROWSER_USE_ENDPOINT": "http://localhost:8000/api/task",
    "DEFAULT_CODE_MODEL": "@cf/meta/llama-3.1-8b-instruct",
    "R2_PREFIX": "Brunella-core"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SWARM_COORDINATOR",
        "class_name": "SwarmCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": [
        "SwarmCoordinator"
      ]
    }
  ],
  "observability": {
    "enabled": true
  }
}
