    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst emailsWithoutAttachment = items.filter(\n  (item) => !item?.json?.headers[\"content-type\"].includes(\"multipart/mixed\"),\n);\nreturn emailsWithoutAttachment;\n"
