{
  "name": "mcp-brunella-core",
  "version": "1.0.0",
  "description": "MCP server for Brunella Core",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "brunella": "build/cli.js",
    "brunella-jules": "build/cli-jules-interactive.js",
    "brunella-hu": "build/cli-hu.js"
  },
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');fs.mkdirSync('build/agents',{recursive:true});fs.copyFileSync('src/agents/registry.json','build/agents/registry.json');console.log('registry.json copied to build/agents/');fs.mkdirSync('build/data',{recursive:true});fs.copyFileSync('src/data/triz_matrix.json','build/data/triz_matrix.json');fs.copyFileSync('src/data/triz_principles.json','build/data/triz_principles.json');console.log('TRIZ data copied');\"",
    "start": "node build/index.js",
    "dev": "node --loader ts-node/esm src/index.ts",
    "watch": "tsc -w",
    "smoke": "node scripts/smoke.mjs",
    "mcp:run": "node build/index.js",
    "cli:run": "node build/cli.js",
    "cli": "node build/cli.js",
    "cli:hu": "node build/cli-hu.js",
    "test": "npm run build && vitest run",
    "lint": "eslint src/ test/ --max-warnings=0",
    "lint:fix": "eslint src/ test/ --fix",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:legacy": "node scripts/test_prepare.cjs && node --test test_build/core_tools.test.js",
    "test:python": "node --loader ts-node/esm --test test/python_shell.test.ts",
    "test:vitest": "vitest run",
    "test:comprehensive": "vitest run test/llm_client.test.ts test/DeveloperAgent.test.ts",
    "test:all": "npm run test:unit:cli && npm run test:factory && npm run test:cli && npm test",
    "build:ui": "vite build src/dashboard",
    "build:overlay": "vite build -c vite.overlay.config.ts",
    "dev:ui": "vite src/dashboard",
    "tauri": "npx @tauri-apps/cli",
    "desktop:dev": "npx @tauri-apps/cli dev",
    "desktop:build": "npx @tauri-apps/cli build",
    "dev:vscode": "code-server --bind-addr 127.0.0.1:8080 --auth none --disable-telemetry .",
    "test:dashboard": "vitest run --config vitest.dashboard.config.ts",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:health": "npx tsx scripts/health_check.ts",
    "health": "npm run test:health",
    "test:phoenix": "vitest run test/state_restoration.test.ts",
    "test:full": "npm run build && vitest run && npm run test:health",
    "genkit:dev": "npx tsx --watch src/genkit-flow.ts",
    "migrate:dry": "npx tsx scripts/migrate-embeddings.ts --dry-run",
    "migrate:backup": "npx tsx scripts/migrate-embeddings.ts --backup",
    "migrate": "npx tsx scripts/migrate-embeddings.ts",
    "prepare": "husky"
  },
  "keywords": [
    "mcp",
    "brunella"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.75.0",
