{
  "name": "Brunella LintFixer Automation",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Every 6 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/api/agents/lint_fixer/execute",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "task",
              "value": "check src/"
            }
          ]
        },
        "options": {}
      },
      "id": "lint-check",
      "name": "Run Lint Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.data?.report?.totalErrors ?? 0 }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "id": "has-errors",
      "name": "Has Errors?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/api/agents/lint_fixer/execute",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "task",
              "value": "fix all"
            }
          ]
        },
        "options": {}
      },
      "id": "auto-fix",
      "name": "Run Auto Fix",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 200]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "status",
              "value": "clean"
            },
            {
              "name": "message",
              "value": "No lint errors found"
            }
          ]
        },
        "options": {}
      },
      "id": "no-errors",
      "name": "All Clean",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [900, 400]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.data?.remainingErrors ?? 0 }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "id": "still-errors",
      "name": "Still Has Errors?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1100, 200]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "alert",
              "value": "manual_fix_needed"
            },
            {
              "name": "errors",
              "value": "={{ $json.data?.remainingErrors }}"
            },
            {
              "name": "timestamp",
              "value": "={{ $now.toISO() }}"
            }
          ]
        },
        "options": {}
      },
      "id": "alert-needed",
      "name": "Prepare Alert",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1300, 100]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "status",
              "value": "fixed"
            },
            {
              "name": "message",
              "value": "All errors auto-fixed successfully"
            }
          ]
        },
        "options": {}
      },
      "id": "all-fixed",
      "name": "All Fixed",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1300, 300]
    },
    {
      "parameters": {
        "mode": "combine",
        "mergeByFields": {},
        "options": {}
      },
      "id": "merge-results",
      "name": "Merge Results",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [1500, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/api/logs",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ agent: 'LintFixer', action: 'scheduled_run', result: $json }) }}",
        "options": {}
      },
      "id": "log-result",
      "name": "Log to Brunella",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1700, 300]
    }
  ],
  "connections": {
    "Every 6 Hours": {
      "main": [
        [
          {
            "node": "Run Lint Check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Lint Check": {
      "main": [
        [
          {
            "node": "Has Errors?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Errors?": {
      "main": [
        [
          {
            "node": "Run Auto Fix",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "All Clean",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Auto Fix": {
      "main": [
        [
          {
            "node": "Still Has Errors?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Still Has Errors?": {
      "main": [
        [
          {
            "node": "Prepare Alert",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "All Fixed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "All Clean": {
      "main": [
        [
          {
            "node": "Merge Results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Alert": {
      "main": [
        [
          {
            "node": "Merge Results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "All Fixed": {
      "main": [
        [
          {
            "node": "Merge Results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Merge Results": {
      "main": [
        [
          {
            "node": "Log to Brunella",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "meta": {
    "instanceId": "brunella-bas",
    "description": "Automatikus ESLint ellenőrzés és javítás 6 óránként. Ha vannak hibák, megpróbálja automatikusan javítani. Ha maradnak, alertet küld."
  }
}
