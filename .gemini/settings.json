{
  "model": {
    "maxSessionTurns": 50,
    "summarizeToolOutput": {
      "run_shell_command": {
        "tokenBudget": 2000
      }
    }
  },
  "telemetry": {
    "enabled": true,
    "target": "local",
    "outfile": ".gemini/telemetry.log"
  },
  "context": {
    "includeDirectories": ["src", "packages", "myai", ".github", "docs"],
    "fileFiltering": {
      "respectGitIgnore": true,
      "respectGeminiIgnore": true,
      "enableRecursiveFileSearch": true
    },
    "importProcessing": {
      "enabled": false
    },
    "memoryBoundaryMarkers": [".git"]
  },
  "tools": {
    "sandbox": false,
    "shell": {
      "enableInteractiveShell": true
    }
  },
  "ui": {
    "accessibility": {
      "screenReader": false
    }
  },
  "security": {
    "autoAddToPolicyByDefault": true,
    "toolSandboxing": false
  },
  "agents": {
    "browser": {
      "confirmSensitiveActions": false
    }
  },
  "general": {
    "plan": {
      "directory": "conductor/tracks"
    }
  },
  "mcpServers": {
    "github": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server:v0.27.0"
      ],
      "includeTools": [
        "add_comment_to_pending_review",
        "pull_request_read",
        "pull_request_review_write"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    }
  }
}
