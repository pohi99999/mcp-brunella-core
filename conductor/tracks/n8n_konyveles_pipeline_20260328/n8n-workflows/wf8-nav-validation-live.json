        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ task: 'Validate the invoice data against NAV and return the status', context: { source: 'n8n', trigger: 'webhook', invoice: $json.invoice, timestamp: $json.timestamp } }) }}",
        "options": {}
      },
      "id": "nav-agent",
      "name": "Validate Invoice with NavAgent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        320
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "summary",
              "name": "summary",
              "value": "={{ { stage: 'temp-nav', source: 'n8n' } }}",
              "type": "object"
            },
            {
              "id": "result",
              "name": "result",
              "value": "={{ $json.result ?? $json.data ?? $json }}",
              "type": "object"
            },
            {
              "id": "exceptions",
              "name": "exceptions",
              "value": "={{ Array.isArray($json.exceptions) ? $json.exceptions : [] }}",
              "type": "array"
            },
            {
              "id": "isSuccess",
              "name": "isSuccess",
              "value": "={{ true }}",
              "type": "boolean"
            },
            {
              "id": "source",
              "name": "source",
              "value": "n8n",
              "type": "string"
            },
            {
              "id": "timestamp",
              "name": "timestamp",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        }
      },
      "id": "temp-set-safe-nav",
      "name": "Normalize Temp Result",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1040,
        320
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const item = items[0]?.json ?? {};\nconst navStatus = item.result?.nav_status ?? item.result?.navStatus ?? item.nav_status ?? item.navStatus ?? 'OK';\nconst hasMismatch = navStatus === 'MISMATCH';\n\nreturn [{\n  json: {\n    ...item,\n    navStatus,\n    hasMismatch,\n    summary: {\n      ...(item.summary ?? {}),\n      navStatus,\n    },\n  },\n}];"
      },
      "id": "temp-code-safe-nav-2",
      "name": "Add NAV Status to Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        320
      ]
    },
