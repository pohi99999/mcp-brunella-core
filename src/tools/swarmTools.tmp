            if (error) {
                console.error('Refiner error:', stderr);
                resolve(null);
                return;
            }
            try {
                resolve(stdout.trim() ? JSON.parse(stdout) : null);
            } catch (e) {
                resolve(null);
            }
        });
        child.stdin?.write(JSON.stringify({ content, source }));
        child.stdin?.end();
    });
}

export function registerSwarmTools(server: McpServer) {
  server.tool(
    "swarm_ingest",
    "Automated web ingestion: Browse -> Refine -> Knowledge Store.",
    {
      url: z.string().url().describe("The URL to ingest"),
      tags: z.array(z.string()).optional().describe("Additional tags for the knowledge base"),
    },
    async ({ url, tags }) => {
      let browserInstance;
      
      try {
        browserInstance = await chromium.launch({ headless: true });
        const page = await browserInstance.newPage();
