FROM python:3.12-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1

RUN pip install --no-cache-dir --upgrade pip \
	&& pip install --no-cache-dir uv

COPY pyproject.toml .
# Install dependencies from pyproject.toml
# We use --system to install into the system python (safe in container)
COPY myai/requirements.txt /app/myai/requirements.txt

RUN uv pip install --system -r /app/myai/requirements.txt

COPY myai/ ./myai/
RUN mkdir -p logs

ENV PYTHONPATH=/app

WORKDIR /app/myai

EXPOSE 8000

CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000"]
