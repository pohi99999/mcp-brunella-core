{
  "mcpServers": {
    "brunella-core": {
      "command": "node",
      "args": [
        "${workspaceFolder}/build/index.js"
      ],
      "env": {
        "NODE_ENV": "development",
        "MCP_DEBUG": "true"
      },
      "notes": "A BAS Központi Agya (Orchestrator)"
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "notes": "ROBOTKÉZ: Böngésző vezérlés és E2E tesztelés"
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${workspaceFolder}"
      ],
      "notes": "Biztonságos fájl hozzáférés a projekthez"
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${input:githubPat}"
      },
      "notes": "GitHub repo/issue/PR/commit kezelés"
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "@anthropic-ai/mcp-server-puppeteer@latest"
      ],
      "notes": "Chrome DevTools vezérlés, screenshot, DOM elemzés"
    },
    "windows-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@anthropic-ai/mcp-server-windows@latest"
      ],
      "notes": "Windows ablak/alkalmazás vezérlés, screenshot, automáció"
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ],
      "notes": "Könyvtár dokumentáció keresés (up-to-date docs)"
    }
  },
  "inputs": [
    {
      "id": "githubPat",
      "type": "promptString",
      "description": "GitHub Personal Access Token (repo/issues scope)",
      "password": true
    }
  ]
}