      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "bas-task-webhook"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "research-condition",
              "leftValue": "={{ $json.type }}",
              "rightValue": "research",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "router-research",
      "name": "Research?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 200]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "code-condition",
              "leftValue": "={{ $json.type }}",
              "rightValue": "code",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "router-code",
      "name": "Code?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:7860/api/v1/run/research-agent",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"input_value\": \"{{ $json.payload.instruction }}\",\n  \"output_type\": \"chat\",\n  \"input_type\": \"chat\",\n  \"tweaks\": {\n    \"task_id\": \"{{ $json.taskId }}\",\n    \"context\": {{ JSON.stringify($json.payload.context || {}) }}\n  }\n}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "langflow-research",
      "name": "Langflow Research",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:7860/api/v1/run/code-agent",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"input_value\": \"{{ $json.payload.instruction }}\",\n  \"output_type\": \"chat\",\n  \"input_type\": \"chat\",\n  \"tweaks\": {\n    \"task_id\": \"{{ $json.taskId }}\",\n    \"language\": \"{{ $json.payload.context?.language || 'python' }}\"\n  }\n}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "langflow-code",
      "name": "Langflow Code",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:7860/api/v1/run/orchestrator-agent",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"input_value\": \"{{ $json.payload.instruction }}\",\n  \"output_type\": \"chat\",\n  \"input_type\": \"chat\",\n  \"tweaks\": {\n    \"task_id\": \"{{ $json.taskId }}\",\n    \"full_context\": {{ JSON.stringify($json.payload) }}\n  }\n}",
        "options": {
          "timeout": 180000
        }
      },
      "id": "langflow-orchestrate",
      "name": "Langflow Orchestrate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 500]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('BAS Webhook').item.json.callbackUrl }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"taskId\": \"{{ $('BAS Webhook').item.json.taskId }}\",\n  \"status\": \"success\",\n  \"result\": {{ JSON.stringify($json) }}\n}",
        "options": {}
      },
      "id": "callback-success",
      "name": "Callback Success",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [940, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('BAS Webhook').item.json.callbackUrl }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"taskId\": \"{{ $('BAS Webhook').item.json.taskId }}\",\n  \"status\": \"failed\",\n  \"result\": {\n    \"error\": \"{{ $json.message || 'Unknown error' }}\"\n  }\n}",
        "options": {}
      },
      "id": "callback-error",
      "name": "Callback Error",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [940, 500]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"received\": true,\n  \"taskId\": \"{{ $('BAS Webhook').item.json.taskId }}\",\n  \"routing\": \"{{ $('BAS Webhook').item.json.type }}\"\n}",
        "options": {}
      },
      "id": "response-immediate",
      "name": "Immediate Response",
      "type": "n8n-nodes-base.respondToWebhook",
