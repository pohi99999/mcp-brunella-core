    {
      "parameters": {
        "jsCode": "// Heti munkaidő összesítő számítás\nconst records = $input.all();\nconst chatId = $('Telegram Trigger').item.json.message.chat.id;\nconst firstName = $('Telegram Trigger').item.json.message.chat.first_name || 'Dolgozó';\n\nlet totalRecords = records.length;\nlet message = `📅 **${firstName} - Heti munkaidő összesítő:**\\n\\n`;\n\nif (totalRecords === 0) {\n  message += '❌ Az elmúlt 7 napban nincs rögzített munkaidő.\\n';\n} else {\n  message += `✅ **${totalRecords}** bejegyzés az elmúlt 7 napban.\\n\\n`;\n  \n  // Dátum szerint csoportosítás\n  const byDate = {};\n  records.forEach(record => {\n    const date = record.json.Dátum || 'Ismeretlen';\n    if (!byDate[date]) {\n      byDate[date] = [];\n    }\n    byDate[date].push(record.json.Megjegyzés || 'Nincs megjegyzés');\n  });\n  \n  // Dátum szerint rendezés\n  const sortedDates = Object.keys(byDate).sort().reverse();\n  \n  sortedDates.forEach(date => {\n    message += `\\n📆 **${date}**\\n`;\n    byDate[date].forEach((megjegyzes, index) => {\n      message += `  ${index + 1}. ${megjegyzes}\\n`;\n    });\n  });\n}\n\nmessage += '\\n💡 Használd a /statusz parancsot a mai státuszhoz.';\n\nreturn [{\n  json: {\n    message: message,\n    chatId: chatId,\n    totalRecords: totalRecords\n  }\n}];"
      },
