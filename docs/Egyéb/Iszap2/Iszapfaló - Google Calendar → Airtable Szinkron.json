    {
      "parameters": {
        "jsCode": "// Google Calendar esemény adatainak feldolgozása\nconst event = $input.item.json;\n\n// Kezdés és befejezés dátum/idő kinyerése\nconst startDate = event.start.dateTime || event.start.date;\nconst endDate = event.end.dateTime || event.end.date;\n\n// Esemény cím és leírás\nconst summary = event.summary || '';\nconst description = event.description || '';\n\n// Felhasználó email kinyerése (ha van)\nconst organizerEmail = event.organizer ? event.organizer.email : null;\n\nreturn [{\n  json: {\n    kezdes: startDate,\n    befejezes: endDate,\n    megjegyzes: `${summary}${description ? ' - ' + description : ''}`,\n    statusz: 'Feldolgozás alatt',\n    calendar_event_id: event.id,\n    organizer_email: organizerEmail,\n    original_summary: summary\n  }\n}];"
      },
