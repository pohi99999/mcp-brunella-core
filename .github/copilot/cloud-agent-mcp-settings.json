{
  "mcpServers": {
    "brunella-core": {
      "type": "local",
      "command": "node",
      "args": [
        "./build/index.js"
      ],
      "tools": [
        "*"
      ],
      "env": {
        "BRUNELLA_SKIP_SECRETS_CHECK": "1",
        "WEB_UI_ENABLED": "0",
        "BRUNELLA_FORCE_STDIO": "1",
        "NODE_ENV": "test",
        "PYTHONPATH": ".",
        "MANIFEST_SIGNING_SECRET": "$COPILOT_MCP_MANIFEST_SIGNING_SECRET"
      }
    },
    "brunella-remote": {
      "type": "http",
      "url": "https://Brunella-Agents-System-Server.fastmcp.app/mcp",
      "tools": [
        "*"
      ]
    },
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:\\",
        "C:\\Users\\pohi9",
        "F:\\mcp-brunella-core"
      ]
    },
    "fetch": {
      "type": "local",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-fetch"
      ],
      "tools": [
        "*"
      ]
    },
    "memory": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "env": {
        "MEMORY_FILE_PATH": "data/mcp_memory.json"
      }
    },
    "sequential-thinking": {
      "type": "local",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "tools": [
        "*"
      ]
    }
  }
}
