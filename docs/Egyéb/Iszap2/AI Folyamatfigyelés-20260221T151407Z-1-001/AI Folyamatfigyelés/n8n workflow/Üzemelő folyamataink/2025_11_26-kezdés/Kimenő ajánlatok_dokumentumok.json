    {
      "parameters": {
        "jsCode": "// Biztosítjuk, hogy a binary adat megfelelő formátumú legyen\nconst items = [];\n\nfor (const item of $input.all()) {\n  const newItem = {\n    json: item.json,\n    binary: {}\n  };\n  \n  // Végigmegyünk az összes binary adaton\n  for (const binaryKey in item.binary) {\n    const binaryData = item.binary[binaryKey];\n    \n    // Biztosítjuk, hogy a mimeType helyes legyen\n    newItem.binary[binaryKey] = {\n      ...binaryData,\n      mimeType: 'application/pdf', // Explicit beállítjuk\n      fileName: binaryData.fileName || 'document.pdf'\n    };\n  }\n  \n  items.push(newItem);\n}\n\nreturn items;"
      },
