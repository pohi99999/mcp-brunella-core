{
  "version": "1.0.0",
  "tools": {
    "ProcessLasso": {
      "name": "Process Lasso",
      "path": "C:\\Tools\\ProcessLasso\\lasso.exe",
      "description": "CPU optimization tool for LLM execution",
      "category": "system_optimization",
      "platform": "windows",
      "usage": "CPU optimalizálás LLM futtatáskor",
      "trigger": {
        "type": "threshold",
        "condition": "cpu_load > 80 AND llm_active = true",
        "cpu_threshold": 80,
        "requires_llm_active": true
      },
      "actions": [
        {
          "name": "optimize",
          "command": "lasso.exe",
          "args": ["/optimize"]
        },
        {
          "name": "balance",
          "command": "lasso.exe",
          "args": ["/balance"]
        }
      ]
    },
    "CrystalDiskInfo": {
      "name": "CrystalDiskInfo",
      "path": "C:\\Tools\\Disk\\CrystalDiskInfo.exe",
      "description": "SSD health monitoring and diagnostics",
      "category": "disk_monitoring",
      "platform": "windows",
      "usage": "SSD állapot monitorozása",
      "trigger": {
        "type": "threshold",
        "condition": "io_latency > 100",
        "io_latency_threshold_ms": 100
      },
      "actions": [
        {
          "name": "check",
          "command": "CrystalDiskInfo.exe",
          "args": ["/CheckHealth"]
        },
        {
          "name": "report",
          "command": "CrystalDiskInfo.exe",
          "args": ["/CopyExit"]
        }
      ]
    },
    "HWiNFO": {
      "name": "HWiNFO",
      "path": "C:\\Tools\\HWiNFO\\HWiNFO64.exe",
      "description": "Hardware monitoring and diagnostics",
      "category": "hardware_monitoring",
      "platform": "windows",
      "usage": "Teljes rendszer monitorozása CPU, GPU, RAM, hőmérséklet",
      "trigger": {
        "type": "threshold",
        "condition": "cpu_temp > 80 OR gpu_temp > 85",
        "cpu_temp_threshold": 80,
        "gpu_temp_threshold": 85
      },
      "actions": [
        {
          "name": "sensors",
          "command": "HWiNFO64.exe",
          "args": ["/Sensors"]
        },
        {
          "name": "report",
          "command": "HWiNFO64.exe",
          "args": ["/Report"]
        }
      ]
    },
    "TaskManager": {
      "name": "Task Manager",
      "path": "C:\\Windows\\System32\\taskmgr.exe",
      "description": "Windows Task Manager for process monitoring",
      "category": "process_monitoring",
      "platform": "windows",
      "usage": "Folyamatok és erőforrások monitorozása",
      "trigger": {
        "type": "manual",
        "condition": "user_request"
      },
      "actions": [
        {
          "name": "open",
          "command": "taskmgr.exe",
          "args": []
        }
      ]
    },
    "GeminiCLI": {
      "name": "Gemini CLI",
      "path": "gemini",
      "description": "Google Gemini CLI agent for code tasks",
      "category": "ai_agent",
      "platform": "cross_platform",
      "usage": "Kód generálás, refaktorálás, review",
      "trigger": {
        "type": "task_based",
        "tasks": ["code_generation", "code_review", "refactoring"]
      },
      "actions": [
        {
          "name": "execute",
          "command": "gemini",
          "args": ["--task", "{task}"]
        }
      ]
    },
    "ClaudeCode": {
      "name": "Claude Code",
      "path": "claude",
      "description": "Claude AI for complex coding tasks",
      "category": "ai_agent",
      "platform": "cross_platform",
      "usage": "Komplex kódolási feladatok, architektúra tervezés",
      "trigger": {
        "type": "task_based",
        "tasks": ["complex_coding", "architecture", "debugging"]
      },
      "actions": [
        {
          "name": "execute",
          "command": "claude",
          "args": ["--task", "{task}"]
        }
      ]
    },
    "Jules": {
      "name": "Jules CLI",
      "path": "jules",
      "description": "Jules AI agent for automated workflows",
      "category": "ai_agent",
      "platform": "cross_platform",
      "usage": "Automatizált workflow-k, batch feladatok",
      "trigger": {
        "type": "task_based",
        "tasks": ["automation", "batch_processing", "workflow"]
      },
      "actions": [
        {
          "name": "execute",
          "command": "jules",
          "args": ["--task", "{task}"]
        }
      ]
    }
  },
  "task_categories": {
    "optimize_cpu": {
      "description": "CPU optimization when under heavy load",
      "preferred_tools": ["ProcessLasso"],
      "priority": "high"
    },
    "check_disk_health": {
      "description": "Check SSD/HDD health status",
      "preferred_tools": ["CrystalDiskInfo"],
      "priority": "medium"
    },
    "monitor_hardware": {
      "description": "Monitor overall hardware status",
      "preferred_tools": ["HWiNFO", "TaskManager"],
      "priority": "medium"
    },
    "code_generation": {
      "description": "Generate new code or boilerplate",
      "preferred_tools": ["GeminiCLI", "ClaudeCode"],
      "priority": "high"
    },
    "code_review": {
      "description": "Review and analyze code quality",
      "preferred_tools": ["GeminiCLI", "ClaudeCode"],
      "priority": "high"
    },
    "automation": {
      "description": "Automate repetitive tasks",
      "preferred_tools": ["Jules"],
      "priority": "medium"
    }
  }
}
